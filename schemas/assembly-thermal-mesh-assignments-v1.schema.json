{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/assembly-thermal-mesh-assignments/v1",
  "title": "Reviewed physical assignments for retained assembly volume generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materials",
    "boards",
    "parts"
  ],
  "properties": {
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provenance",
          "thermal_conductivity_w_mk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "thermal_conductivity_w_mk": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "boards": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representation",
          "layer_materials"
        ],
        "properties": {
          "representation": {
            "const": "layer_homogenized"
          },
          "layer_materials": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "parts": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "encapsulation": {
      "$ref": "assembly-thermal-encapsulation-v1.schema.json"
    }
  }
}
