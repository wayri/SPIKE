{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/pdn-admittance-reduction-request/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0; exact port/frequency partition, SI values, passivity and resource admission additionally checked by solver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source",
    "retained_nodes",
    "eliminated_nodes",
    "termination_admittance_s"
  ],
  "properties": {
    "contract": {
      "const": "spike/pdn-admittance-reduction-request/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "reference_node",
        "frequencies_hz",
        "admittance_s",
        "model_status",
        "source_id",
        "context_digest"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "reference_node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "frequencies_hz": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "admittance_s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "real",
                  "imag"
                ],
                "properties": {
                  "real": {
                    "type": "number"
                  },
                  "imag": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "model_status": {
          "enum": [
            "approximate",
            "experimental"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "retained_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "eliminated_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "termination_admittance_s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "imag"
            ],
            "properties": {
              "real": {
                "type": "number"
              },
              "imag": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
