{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/pdn-dielectric-feedback-result/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0; raw closure, cell state/identity and law ranges additionally checked by implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "coupling_mode",
    "conductivity_laws",
    "iteration",
    "operating_temperature_k",
    "cell_material_state",
    "last_coupled_result",
    "history",
    "diagnostics",
    "limitations",
    "input_digest",
    "base_input_digest",
    "original_mesh_digest",
    "generated_mesh_digest",
    "generated_input_digest",
    "context_digest"
  ],
  "properties": {
    "contract": {
      "const": "spike/pdn-dielectric-feedback-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "coupling_mode": {
      "const": "two_way_conductivity_temperature"
    },
    "conductivity_laws": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "reference_temperature_k",
          "temperature_coefficient_per_k",
          "temperature_range_k"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reference_temperature_k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "temperature_coefficient_per_k": {
            "type": "number"
          },
          "temperature_range_k": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_temperature_k",
        "max_iterations",
        "relaxation",
        "temperature_tolerance_k",
        "power_relative_tolerance"
      ],
      "properties": {
        "initial_temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "relaxation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "temperature_tolerance_k": {
          "type": "number",
          "minimum": 1e-10,
          "maximum": 1
        },
        "power_relative_tolerance": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 0.01
        }
      }
    },
    "operating_temperature_k": {
      "type": "array",
      "minItems": 4,
      "maxItems": 1000,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "cell_material_state": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "original_material_id",
          "generated_material_id",
          "source_object_ids",
          "mean_temperature_k",
          "conductivity_s_m"
        ],
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "original_material_id": {
            "type": "string"
          },
          "generated_material_id": {
            "type": "string"
          },
          "source_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mean_temperature_k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "conductivity_s_m": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "last_coupled_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "model_status",
        "production_qualified",
        "coupling_mode",
        "frequency_hz",
        "drive",
        "nodes",
        "reference_node",
        "heat_sources_w_m3",
        "cell_power_w",
        "cell_lineage",
        "total_dielectric_power_w",
        "port_power_w",
        "loss_relative_error",
        "thermal_result",
        "electrical_diagnostics",
        "diagnostics",
        "limitations",
        "input_digest",
        "electrical_input_digest",
        "thermal_input_digest",
        "generated_thermal_input_digest",
        "mesh_digest",
        "context_digest"
      ],
      "properties": {
        "contract": {
          "const": "spike/pdn-dielectric-thermal-result/v1"
        },
        "model_status": {
          "const": "experimental"
        },
        "production_qualified": {
          "const": false
        },
        "coupling_mode": {
          "const": "one_way_no_temperature_feedback"
        },
        "frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "drive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequency_hz",
            "voltages_v"
          ],
          "properties": {
            "frequency_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "voltages_v": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 15,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "real",
                  "imag"
                ],
                "properties": {
                  "real": {
                    "type": "number"
                  },
                  "imag": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reference_node": {
          "type": "string"
        },
        "heat_sources_w_m3": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2000,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "cell_power_w": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2000,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "cell_lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_id",
              "material_id",
              "source_object_ids",
              "volume_m3"
            ],
            "properties": {
              "cell_id": {
                "type": "string"
              },
              "material_id": {
                "type": "string"
              },
              "source_object_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "volume_m3": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "total_dielectric_power_w": {
          "type": "number",
          "minimum": 0
        },
        "port_power_w": {
          "type": "number"
        },
        "loss_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "thermal_result": {
          "type": "object",
          "required": [
            "contract",
            "model_status",
            "production_qualified",
            "node_temperatures_k",
            "heat_balance"
          ],
          "properties": {
            "contract": {
              "const": "spike/assembly-tetra-thermal-result/v1"
            },
            "model_status": {
              "const": "experimental"
            },
            "production_qualified": {
              "const": false
            },
            "node_temperatures_k": {
              "type": "array",
              "minItems": 4,
              "maxItems": 1000,
              "items": {
                "type": "number"
              }
            },
            "heat_balance": {
              "type": "object"
            }
          }
        },
        "electrical_diagnostics": {
          "type": "object"
        },
        "diagnostics": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "electrical_input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "thermal_input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_thermal_input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mesh_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temperature_residual_k",
          "total_dielectric_power_w",
          "minimum_temperature_k",
          "maximum_temperature_k",
          "iteration",
          "power_relative_change"
        ],
        "properties": {
          "temperature_residual_k": {
            "type": "number",
            "minimum": 0
          },
          "total_dielectric_power_w": {
            "type": "number",
            "minimum": 0
          },
          "minimum_temperature_k": {
            "type": "number",
            "minimum": 0
          },
          "maximum_temperature_k": {
            "type": "number",
            "minimum": 0
          },
          "iteration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "power_relative_change": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "diagnostics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_mesh_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_mesh_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
