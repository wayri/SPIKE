{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/assembly-field-handoff-request-v1.schema.json",
  "title": "SPIKE retained assembly field handoff request",
  "description": "Original Apache-2.0 contract, Copyright 2026 SigHarmonic. Semantic admission checks coverage, finite rigid placements, positive tetrahedra, and materials. Source and stack hashes are caller bindings, not verified CAD authenticity.",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "assembly", "domain", "bodies", "materials"],
  "properties": {
    "contract": {"const": "spike/assembly-field-handoff-request/v1"},
    "assembly": {"$ref": "assembly-ir-v1.schema.json"},
    "domain": {"enum": ["thermal", "em", "si"]},
    "resource_profile": {"const": "routed_pcb_em_v1"},
    "bodies": {"type": "array", "minItems": 1, "maxItems": 130, "items": {"$ref": "#/$defs/body"}},
    "materials": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"oneOf": [{"$ref": "#/$defs/thermalMaterial"}, {"$ref": "#/$defs/emMaterial"}]}},
    "ports": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/port"}}
  },
  "allOf": [
    {"if": {"required": ["resource_profile"]}, "then": {"properties": {"domain": {"const": "em"}}}, "else": {"properties": {"bodies": {"items": {"properties": {"mesh": {"properties": {"vertices": {"maxItems": 100000}, "cells": {"maxItems": 100000}}}, "boundary_faces": {"maxItems": 400000}}}}}}},
    {"if": {"properties": {"domain": {"const": "thermal"}}}, "then": {"properties": {"materials": {"items": {"$ref": "#/$defs/thermalMaterial"}}, "ports": {"maxItems": 0}}}, "else": {"properties": {"materials": {"items": {"$ref": "#/$defs/emMaterial"}}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["occurrence_id", "face_id"], "properties": {"occurrence_id": {"$ref": "#/$defs/id"}, "face_id": {"$ref": "#/$defs/id"}}},
    "face": {"type": "object", "additionalProperties": false, "required": ["id", "vertices"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "vertices": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}},
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["occurrence_id", "reference_id", "source_sha256", "mesh", "boundary_faces", "material_map"],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/id"}, "reference_id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/digest"},
        "mesh": {"allOf": [{"$ref": "solver-mesh-v1.schema.json"}, {"properties": {"vertices": {"minItems": 4, "maxItems": 200000}, "cells": {"minItems": 1, "maxItems": 600000, "items": {"required": ["material_id"], "properties": {"kind": {"const": "tetrahedron"}, "vertices": {"minItems": 4, "maxItems": 4}}}}}}]},
        "boundary_faces": {"type": "array", "maxItems": 2400000, "items": {"$ref": "#/$defs/face"}},
        "material_map": {"type": "object", "minProperties": 1, "maxProperties": 1024, "additionalProperties": {"$ref": "#/$defs/id"}},
        "stack_binding": {"type": "object", "additionalProperties": false, "required": ["id", "source_sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/digest"}}}
      }
    },
    "tensor": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}]},
    "thermalMaterial": {"type": "object", "additionalProperties": false, "required": ["id", "provenance", "thermal_conductivity_w_mk"], "properties": {"id": {"$ref": "#/$defs/id"}, "provenance": {"$ref": "#/$defs/id"}, "thermal_conductivity_w_mk": {"$ref": "#/$defs/tensor"}}},
    "emMaterial": {"type": "object", "additionalProperties": false, "required": ["id", "provenance", "conductivity_s_m", "relative_permittivity", "relative_permeability"], "properties": {"id": {"$ref": "#/$defs/id"}, "provenance": {"$ref": "#/$defs/id"}, "conductivity_s_m": {"type": "number", "minimum": 0}, "relative_permittivity": {"type": "number", "exclusiveMinimum": 0}, "relative_permeability": {"type": "number", "exclusiveMinimum": 0}}},
    "port": {"type": "object", "additionalProperties": false, "required": ["id", "signal", "return", "reference_impedance_ohm"], "properties": {"id": {"$ref": "#/$defs/id"}, "signal": {"$ref": "#/$defs/endpoint"}, "return": {"$ref": "#/$defs/endpoint"}, "reference_impedance_ohm": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
