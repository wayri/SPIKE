{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/converter-study-v1.schema.json",
  "title": "SPIKE PWM Converter Study v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract", "study_id", "name", "topology", "switching", "workspace",
    "waveform_bindings", "measurement_window"
  ],
  "properties": {
    "contract": { "const": "spike/converter-study/v1" },
    "study_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "topology": {
      "enum": ["buck", "boost", "buck_boost", "flyback", "forward", "half_bridge", "full_bridge", "push_pull", "cuk", "sepic", "custom_pwm"]
    },
    "switching": {
      "type": "object",
      "required": ["frequency_hz", "duty_cycle"],
      "properties": {
        "frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
        "duty_cycle": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "dead_time_s": { "type": "number", "minimum": 0 },
        "phase_offsets_deg": { "type": "array", "items": { "type": "number" } },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model_id", "high"],
            "properties": {
              "model_id": { "type": "string", "minLength": 1 },
              "role": { "enum": ["gate", "input", "load", "control", "other"] },
              "low": { "type": "number" },
              "high": { "type": "number" },
              "delay_s": { "type": "number", "minimum": 0 },
              "rise_s": { "type": "number", "minimum": 0 },
              "fall_s": { "type": "number", "minimum": 0 },
              "on_time_s": { "type": "number", "exclusiveMinimum": 0 },
              "frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
              "duty_cycle": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "phase_deg": { "type": "number" }
            }
          }
        }
      }
    },
    "workspace": { "$ref": "spice-workspace-v1.schema.json" },
    "waveform_bindings": {
      "type": "object",
      "required": ["input_voltage", "input_current", "output_voltage", "output_current"],
      "properties": {
        "input_voltage": { "$ref": "#/$defs/vector" },
        "input_current": { "$ref": "#/$defs/vector" },
        "output_voltage": { "$ref": "#/$defs/vector" },
        "output_current": { "$ref": "#/$defs/vector" },
        "switch_node_voltage": { "$ref": "#/$defs/vector" },
        "input_voltage_polarity": { "enum": [-1, 1] },
        "input_current_polarity": { "enum": [-1, 1] },
        "output_voltage_polarity": { "enum": [-1, 1] },
        "output_current_polarity": { "enum": [-1, 1] }
      }
    },
    "measurement_window": {
      "type": "object",
      "required": ["start_s", "stop_s"],
      "properties": {
        "start_s": { "type": "number", "minimum": 0 },
        "stop_s": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": { "enum": ["startup", "steady_state", "inrush", "custom"] }
      }
    },
    "peec": {
      "type": "object",
      "required": ["mappings"],
      "properties": {
        "mappings": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "loss_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reference": { "type": "string", "maxLength": 128 },
          "power_vector": { "$ref": "#/$defs/vector" },
          "voltage_vector": { "$ref": "#/$defs/vector" },
          "current_vector": { "$ref": "#/$defs/vector" },
          "polarity": { "enum": [-1, 1] },
          "ratings": { "type": "object" },
          "thermal": {
            "type": "object",
            "properties": {
              "theta_ja_c_per_w": { "type": "number", "exclusiveMinimum": 0 },
              "thermal_capacitance_j_per_c": { "type": "number", "minimum": 0 }
            }
          }
        },
        "anyOf": [
          { "required": ["power_vector"] },
          { "required": ["voltage_vector", "current_vector"] }
        ]
      }
    },
    "thermal_scenario": { "type": "object" }
    ,"limits": {
      "type": "object",
      "properties": {
        "minimum_efficiency_percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "maximum_output_ripple_v": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_input_inrush_a": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "vector": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
