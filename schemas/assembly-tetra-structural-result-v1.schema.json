{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/assembly-tetra-structural-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "input_digest",
    "mesh_digest",
    "context_digest",
    "mesh",
    "materials",
    "nodal_temperatures_k",
    "dirichlet",
    "nodal_forces_n",
    "units",
    "node_displacements_m",
    "reactions_n",
    "cells",
    "elastic_energy_j",
    "diagnostics",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "spike/assembly-tetra-structural-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mesh_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mesh": {
      "title": "SPIKE Solver Mesh Interchange v1",
      "description": "Bounded solver-neutral mesh/artifact exchange. It preserves source-object ownership and units but does not assert mesh quality, convergence, or physical validity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "units",
        "coordinate_system",
        "vertices",
        "cells",
        "object_map",
        "counts"
      ],
      "properties": {
        "contract": {
          "const": "spike/solver-mesh/v1"
        },
        "units": {
          "enum": [
            "m",
            "mm"
          ]
        },
        "coordinate_system": {
          "enum": [
            "right_handed_xyz"
          ]
        },
        "vertices": {
          "type": "array",
          "maxItems": 10000000,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false
          }
        },
        "cells": {
          "type": "array",
          "maxItems": 20000000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "vertices",
              "source_object_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "line",
                  "triangle",
                  "quad",
                  "tetrahedron",
                  "hexahedron"
                ]
              },
              "vertices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "source_object_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "material_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "object_map": {
          "type": "object",
          "maxProperties": 1000000,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "net": {
                "type": "string"
              },
              "layer": {
                "type": "string"
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vertices",
            "cells"
          ],
          "properties": {
            "vertices": {
              "type": "integer",
              "minimum": 0
            },
            "cells": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "young_modulus_pa",
          "poisson_ratio",
          "thermal_expansion_per_k",
          "reference_temperature_k"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "young_modulus_pa": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "poisson_ratio": {
            "type": "number",
            "exclusiveMinimum": -1,
            "maximum": 0.49
          },
          "thermal_expansion_per_k": {
            "type": "number"
          },
          "reference_temperature_k": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "nodal_temperatures_k": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxProperties": 256
        }
      ]
    },
    "dirichlet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "component",
          "displacement_m"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "component": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "displacement_m": {
            "type": "number"
          }
        }
      },
      "minItems": 0,
      "maxItems": 768
    },
    "nodal_forces_n": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "maxProperties": 256
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displacement",
        "force",
        "stress",
        "temperature"
      ],
      "properties": {
        "displacement": {
          "const": "m"
        },
        "force": {
          "const": "N"
        },
        "stress": {
          "const": "Pa"
        },
        "temperature": {
          "const": "K"
        }
      }
    },
    "node_displacements_m": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 4,
      "maxItems": 256
    },
    "reactions_n": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "component",
          "force_n"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "component": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "force_n": {
            "type": "number"
          }
        }
      },
      "minItems": 0,
      "maxItems": 768
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "material_id",
          "source_object_ids",
          "volume_m3",
          "total_strain",
          "thermal_strain",
          "stress_pa",
          "von_mises_pa",
          "elastic_energy_j"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_object_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1
          },
          "volume_m3": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "total_strain": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "thermal_strain": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "stress_pa": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "von_mises_pa": {
            "type": "number",
            "minimum": 0
          },
          "elastic_energy_j": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "elastic_energy_j": {
      "type": "number",
      "minimum": 0
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_dofs",
        "equilibrated_condition",
        "free_relative_residual",
        "free_max_residual_n",
        "max_element_jacobian_condition",
        "estimated_work"
      ],
      "properties": {
        "free_dofs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192
        },
        "equilibrated_condition": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000000000.0
        },
        "free_relative_residual": {
          "type": "number",
          "minimum": 0
        },
        "free_max_residual_n": {
          "type": "number",
          "minimum": 0
        },
        "max_element_jacobian_condition": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "estimated_work": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1
    }
  }
}
