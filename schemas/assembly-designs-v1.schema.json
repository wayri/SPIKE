{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/assembly-designs-v1.schema.json",
  "title": "SPIKE Assembly Designs v1",
  "type": "object",
  "required": ["contract", "active_design_id", "designs"],
  "properties": {
    "contract": { "const": "spike/assembly-designs/v1" },
    "active_design_id": { "type": "string", "minLength": 1 },
    "designs": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": { "$ref": "design-ir-v2.schema.json" }
    }
  },
  "additionalProperties": false
}
