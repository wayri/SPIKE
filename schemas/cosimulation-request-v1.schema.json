{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "spike/cosimulation-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "model_id", "model_revision", "step_s", "steps", "participants", "connections"],
  "properties": {
    "contract": {"const": "spike/cosimulation-request/v1"},
    "model_id": {"$ref": "#/$defs/identity"},
    "model_revision": {"$ref": "#/$defs/identity"},
    "step_s": {"type": "number", "exclusiveMinimum": 0},
    "steps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "participants": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/participant"}},
    "connections": {"type": "array", "maxItems": 2048, "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "target"],
      "properties": {"source": {"$ref": "#/$defs/endpoint"}, "target": {"$ref": "#/$defs/endpoint"}}
    }}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "endpoint": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/identity"}},
    "ports": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/identity"}, "additionalProperties": {"$ref": "#/$defs/identity"}},
    "values": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/identity"}, "additionalProperties": {"type": "number"}},
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "model_revision", "model_status", "adapter", "inputs", "outputs", "initial_outputs", "config"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "model_revision": {"$ref": "#/$defs/identity"},
        "model_status": {"enum": ["experimental", "approximate", "validated", "unsupported"]},
        "adapter": {"$ref": "#/$defs/identity"},
        "inputs": {"$ref": "#/$defs/ports"},
        "outputs": {"allOf": [{"$ref": "#/$defs/ports"}, {"minProperties": 1}]},
        "initial_outputs": {"$ref": "#/$defs/values"}, "config": {"type": "object"}
      }
    }
  }
}
