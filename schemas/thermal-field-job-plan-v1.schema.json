{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/thermal-field-job-plan-v1.schema.json",
  "title": "SPIKE Thermal Field Job Plan v1",
  "type": "object",
  "required": ["contract", "status", "result_contract", "requested_physics", "solver_selection", "scenario_digest", "geometry", "resource_budget", "cancellation", "execution", "qualification", "issues", "plan_digest"],
  "properties": {
    "contract": {"const": "spike/thermal-field-job-plan/v1"},
    "job_id": {"type": "string"}, "status": {"enum": ["ready_for_execution", "blocked"]},
    "result_contract": {"const": "spike/thermal-field-result/v1"}, "requested_physics": {"type": "array", "items": {"type": "string"}},
    "solver_selection": {"type": "object"}, "scenario_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "geometry": {"type": "object"}, "resource_budget": {"type": "object"},
    "cancellation": {"type": "object"}, "execution": {"type": "object"}, "qualification": {"type": "object"},
    "issues": {"type": "array", "items": {"type": "object"}}, "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }, "additionalProperties": false
}
