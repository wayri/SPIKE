{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/si-clock-recovery-v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT; Copyright (c) 2026 SigHarmonic",
  "title": "Approximate NRZ transition-PI timing recovery configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "transition_pi"},
    "threshold_v": {"type": "number"},
    "normalization_v": {"type": "number", "minimum": 1e-12, "maximum": 1e12},
    "initial_phase_ui": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "proportional_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
    "integral_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.125},
    "max_frequency_offset_ppm": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
    "max_symbols": {"type": "integer", "minimum": 1, "maximum": 65536}
  }
}
