{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/parallel-batch/v1",
  "title": "Bounded independent parallel analysis batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "jobs",
    "concurrency",
    "threads_per_job",
    "timeout_s"
  ],
  "properties": {
    "contract": {
      "const": "spike/parallel-batch/v1"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "threads_per_job": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "method": {
            "enum": [
              "analyze_ac_power_integrity",
              "estimate_thermal",
              "evaluate_capacitor_placement",
              "extract_harness_round_wire_rlgc",
              "run_harness_mtl",
              "run_harness_pi",
              "run_harness_si",
              "run_internal_airflow",
              "run_smps_converter"
            ]
          },
          "params": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces unique IDs, exact inline params, finite JSON, CPU and structural/byte budgets. Numerical admission remains solver-owned."
}
