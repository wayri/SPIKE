{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.dev/schemas/part-limits-v1.schema.json",
  "title": "Explicit part operating limits and captured observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "rules"
  ],
  "properties": {
    "contract": {
      "const": "spike/part-limits/v1"
    },
    "rules": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "occurrence_id",
          "component_id",
          "label",
          "quantity",
          "unit",
          "lower",
          "upper",
          "reference",
          "value",
          "rating_source",
          "measurement_source",
          "evidence_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurrence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "quantity": {
            "enum": [
              "voltage",
              "current",
              "temperature",
              "power",
              "stress",
              "frequency"
            ]
          },
          "unit": {
            "enum": [
              "V",
              "A",
              "degC",
              "K",
              "W",
              "Pa",
              "MPa",
              "Hz"
            ]
          },
          "lower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reference": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rating_source": {
            "type": "string",
            "maxLength": 2000
          },
          "measurement_source": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence_status": {
            "enum": [
              "reviewed",
              "unreviewed"
            ]
          }
        }
      }
    }
  }
}
