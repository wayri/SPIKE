{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/rlgc-line-network-result-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "input_digest",
    "source_request",
    "network",
    "diagnostics",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "spike/rlgc-line-network-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "length_m",
        "reference_impedance_ohm",
        "inductance_h_per_m",
        "capacitance_f_per_m",
        "samples"
      ],
      "properties": {
        "contract": {
          "const": "spike/rlgc-line-network-request/v1"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inductance_h_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacitance_f_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frequency_hz",
              "resistance_ohm_per_m",
              "conductance_s_per_m"
            ],
            "properties": {
              "frequency_hz": {
                "type": "number",
                "minimum": 0
              },
              "resistance_ohm_per_m": {
                "type": "number",
                "minimum": 0
              },
              "conductance_s_per_m": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "port_names",
        "reference_impedance_ohm",
        "frequencies_hz",
        "s_parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "port_names": {
          "const": [
            "left",
            "right"
          ]
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequencies_hz": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "s_parameters": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "real",
                  "imag"
                ],
                "properties": {
                  "real": {
                    "type": "number"
                  },
                  "imag": {
                    "type": "number"
                  }
                }
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 1024
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "maximum_passivity_excess",
        "maximum_reciprocity_error"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maximum_passivity_excess": {
          "type": "number",
          "minimum": 0
        },
        "maximum_reciprocity_error": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
