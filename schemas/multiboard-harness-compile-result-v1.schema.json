{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/multiboard-harness-compile-result-v1.schema.json",
  "title": "SPIKE multi-board harness compile result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "domain", "plan_contract", "plan_digest", "model_status", "production_qualified", "circuit_fragment", "coupling", "release_gate", "result_digest"],
  "properties": {
    "contract": {"const": "spike/multiboard-harness-compile-result/v1"},
    "status": {"const": "compiled"},
    "domain": {"enum": ["pi", "si"]},
    "plan_contract": {"const": "spike/multiboard-analysis-plan/v1"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_status": {"const": "explicit_circuit_fragment_only"},
    "production_qualified": {"const": false},
    "circuit_fragment": {"type": "object"},
    "coupling": {"type": "object"},
    "release_gate": {"type": "object"},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
