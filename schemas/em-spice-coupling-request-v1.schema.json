{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/em-spice-coupling-request/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Finite JSON and 8 MiB transport admission are mandatory. Exact matrix dimensions, ordered frequency/port agreement, case-folded uniqueness, 64-node limit, passivity, conditioning and conservation remain decoder gates. No native AC, nonlinear or transient capability is asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "source", "wave_convention", "circuit", "port_bindings"],
  "properties": {
    "contract": {"const": "spike/em-spice-coupling-request/v1"},
    "wave_convention": {"const": "rms_power_waves_common_positive_real_reference"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "port_names", "reference_impedance_ohm", "frequencies_hz", "s_parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "port_names": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
        "reference_impedance_ohm": {"type": "number", "minimum": 1e-6, "maximum": 1e9},
        "frequencies_hz": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1e15}},
        "s_parameters": {"type": "array", "minItems": 1, "maxItems": 64,
          "items": {"type": "array", "minItems": 1, "maxItems": 16,
            "items": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/complex_object"}}}}
      }
    },
    "circuit": {
      "type": "object", "additionalProperties": false, "required": ["ground_node", "elements"],
      "properties": {
        "ground_node": {"$ref": "#/$defs/circuit_id"},
        "elements": {"type": "array", "minItems": 1, "maxItems": 128,
          "items": {"oneOf": [{"$ref": "#/$defs/passive_element"}, {"$ref": "#/$defs/source_element"}]}}
      }
    },
    "port_bindings": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["positive_node", "negative_node", "reference_plane"],
        "properties": {
          "positive_node": {"$ref": "#/$defs/circuit_id"},
          "negative_node": {"$ref": "#/$defs/circuit_id"},
          "reference_plane": {"type": "string", "minLength": 1, "maxLength": 128,
            "allOf": [{"pattern": "\\S"}, {"not": {"pattern": "[\\r\\n\\u0000]"}}]}
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
    "circuit_id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_.:-]+$", "not": {"pattern": "\\s"}},
    "finite_number": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "complex_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1e100, "maximum": 1e100}},
    "complex_object": {
      "type": "object", "additionalProperties": false, "required": ["real", "imag"],
      "properties": {"real": {"$ref": "#/$defs/finite_number"}, "imag": {"$ref": "#/$defs/finite_number"}}
    },
    "passive_element": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "positive_node", "negative_node", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/circuit_id"},
        "type": {"enum": ["resistor", "capacitor", "inductor"]},
        "positive_node": {"$ref": "#/$defs/circuit_id"},
        "negative_node": {"$ref": "#/$defs/circuit_id"},
        "value": {"type": "number", "minimum": 1e-18, "maximum": 1e18}
      }
    },
    "source_element": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "positive_node", "negative_node", "phasor"],
      "properties": {
        "id": {"$ref": "#/$defs/circuit_id"},
        "type": {"enum": ["voltage_source", "current_source"]},
        "positive_node": {"$ref": "#/$defs/circuit_id"},
        "negative_node": {"$ref": "#/$defs/circuit_id"},
        "phasor": {"$ref": "#/$defs/complex_pair"}
      }
    }
  }
}
