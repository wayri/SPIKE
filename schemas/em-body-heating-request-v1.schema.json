{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/em-body-heating-request/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Finite JSON and 8 MiB admission are mandatory. Exact named-key coverage, counts, mesh topology, digest/context equality, full passive-wave admission, raw Poynting closure, conditioning and conservative thermal transfer remain decoder gates. Structural validation does not attest solver authenticity or shared FE mesh identity.",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "ac_request", "thermal_request", "loss_materials", "field_samples", "port_faces", "source_binding"],
  "properties": {
    "contract": {"const": "spike/em-body-heating-request/v1"},
    "ac_request": {"$ref": "#/$defs/ac_request"},
    "thermal_request": {"$ref": "#/$defs/thermal_request"},
    "loss_materials": {
      "type": "object", "minProperties": 1, "maxProperties": 512,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["conductivity_s_m", "permittivity_f_m", "loss_tangent"],
        "properties": {
          "conductivity_s_m": {"$ref": "#/$defs/nonnegative"},
          "permittivity_f_m": {"$ref": "#/$defs/positive"},
          "loss_tangent": {"$ref": "#/$defs/nonnegative"}
        }
      }
    },
    "port_faces": {"type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true, "items": {"$ref": "#/$defs/face_key"}},
    "field_samples": {
      "type": "object", "additionalProperties": false, "required": ["context", "cells", "boundary_faces"],
      "properties": {
        "context": {
          "type": "object", "additionalProperties": false,
          "required": ["frequency_hz", "mesh_digest", "loss_materials_digest", "ac_source_digest", "port_faces_digest", "solver_run_digest"],
          "properties": {
            "frequency_hz": {"$ref": "#/$defs/nonnegative"},
            "mesh_digest": {"$ref": "#/$defs/sha256"},
            "loss_materials_digest": {"$ref": "#/$defs/sha256"},
            "ac_source_digest": {"$ref": "#/$defs/sha256"},
            "port_faces_digest": {"$ref": "#/$defs/sha256"},
            "solver_run_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "cells": {"type": "object", "minProperties": 1, "maxProperties": 512,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"$ref": "#/$defs/complex_vector"}}},
        "boundary_faces": {"type": "object", "minProperties": 1, "maxProperties": 2048,
          "propertyNames": {"$ref": "#/$defs/face_key"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["e", "h"],
            "properties": {"e": {"$ref": "#/$defs/face_vectors"}, "h": {"$ref": "#/$defs/face_vectors"}}
          }}
      }
    },
    "source_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["mesh_digest", "ac_request_digest", "solver_run_digest", "field_samples_digest"],
      "properties": {
        "mesh_digest": {"$ref": "#/$defs/sha256"}, "ac_request_digest": {"$ref": "#/$defs/sha256"},
        "solver_run_digest": {"$ref": "#/$defs/sha256"}, "field_samples_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "number": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "nonnegative": {"type": "number", "minimum": 0, "maximum": 1.7976931348623157e308},
    "positive": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.7976931348623157e308},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "face_key": {"type": "string", "maxLength": 32, "pattern": "^[0-9]+:[0-9]+:[0-9]+$"},
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/number"}},
    "bounded_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1e100, "maximum": 1e100}},
    "complex_vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/pair"}},
    "face_vectors": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/complex_vector"}},
    "complex_object": {"type": "object", "additionalProperties": false, "required": ["real", "imag"],
      "properties": {"real": {"$ref": "#/$defs/number"}, "imag": {"$ref": "#/$defs/number"}}},
    "ac_request": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "source", "wave_convention", "boundaries"],
      "properties": {
        "contract": {"const": "spike/em-network-ac-request/v1"},
        "wave_convention": {"const": "rms_power_waves_common_positive_real_reference"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "port_names", "reference_impedance_ohm", "frequencies_hz", "s_parameters"],
          "properties": {
            "id": {"$ref": "#/$defs/name"},
            "port_names": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/name"}},
            "reference_impedance_ohm": {"type": "number", "minimum": 1e-6, "maximum": 1e9},
            "frequencies_hz": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/nonnegative"}},
            "s_parameters": {"type": "array", "minItems": 1, "maxItems": 1,
              "items": {"type": "array", "minItems": 1, "maxItems": 1,
                "items": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/complex_object"}}}}
          }
        },
        "boundaries": {"type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "object", "minProperties": 1, "maxProperties": 1,
            "propertyNames": {"$ref": "#/$defs/name"},
            "additionalProperties": {"type": "object", "additionalProperties": false,
              "required": ["voltage_v", "impedance_ohm"],
              "properties": {"voltage_v": {"$ref": "#/$defs/bounded_pair"}, "impedance_ohm": {"$ref": "#/$defs/bounded_pair"}}}}}
      }
    },
    "face_indices": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 2047}},
    "thermal_request": {
      "type": "object", "additionalProperties": false, "required": ["contract", "mesh", "materials", "boundaries"],
      "properties": {
        "contract": {"const": "spike/assembly-tetra-thermal-request/v1"}, "mode": {"const": "steady_state"},
        "mesh": {"$ref": "#/$defs/mesh"},
        "heat_sources_w_m3": {"type": "object", "maxProperties": 0},
        "materials": {"type": "array", "minItems": 1, "maxItems": 100000,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "thermal_conductivity_w_mk"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "thermal_conductivity_w_mk": {"oneOf": [{"$ref": "#/$defs/positive"},
                {"type": "array", "minItems": 3, "maxItems": 3,
                  "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/number"}}}]}
            }}},
        "boundaries": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/thermal_boundary"}},
        "contacts": {"type": "array", "maxItems": 1024,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["id", "left_vertices", "right_vertices", "thermal_contact_conductance_w_m2k"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "left_vertices": {"$ref": "#/$defs/face_indices"},
              "right_vertices": {"$ref": "#/$defs/face_indices"}, "thermal_contact_conductance_w_m2k": {"$ref": "#/$defs/positive"}}}}
      }
    },
    "mesh": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "units", "coordinate_system", "vertices", "cells", "counts", "object_map"],
      "properties": {
        "contract": {"const": "spike/solver-mesh/v1"}, "units": {"enum": ["m", "mm"]},
        "coordinate_system": {"const": "right_handed_xyz"},
        "vertices": {"type": "array", "minItems": 4, "maxItems": 2048,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1e9, "maximum": 1e9}}},
        "cells": {"type": "array", "minItems": 1, "maxItems": 512,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["id", "kind", "vertices", "material_id", "source_object_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/id"}, "kind": {"const": "tetrahedron"}, "material_id": {"$ref": "#/$defs/id"},
              "vertices": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0, "maximum": 2047}},
              "source_object_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
            }}},
        "counts": {"type": "object", "additionalProperties": false, "required": ["vertices", "cells"],
          "properties": {"vertices": {"type": "integer", "minimum": 4, "maximum": 2048}, "cells": {"type": "integer", "minimum": 1, "maximum": 512}}},
        "object_map": {"type": "object", "maxProperties": 100000, "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["kind"],
            "properties": {"kind": {"$ref": "#/$defs/id"}, "net": {"$ref": "#/$defs/id"}, "layer": {"$ref": "#/$defs/id"},
              "occurrence_id": {"$ref": "#/$defs/id"}, "body_id": {"$ref": "#/$defs/id"}}}}
      }
    },
    "thermal_boundary": {
      "type": "object", "required": ["id", "vertices", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "vertices": {"$ref": "#/$defs/face_indices"}},
      "oneOf": [
        {"properties": {"type": {"const": "temperature"}, "temperature_k": {"$ref": "#/$defs/nonnegative"}}, "required": ["temperature_k"]},
        {"properties": {"type": {"const": "heat_flux"}, "heat_flux_w_m2": {"$ref": "#/$defs/number"}}, "required": ["heat_flux_w_m2"]},
        {"properties": {"type": {"const": "adiabatic"}}},
        {"properties": {"type": {"const": "convection"}, "heat_transfer_coefficient_w_m2k": {"$ref": "#/$defs/positive"}, "ambient_temperature_k": {"$ref": "#/$defs/nonnegative"}}, "required": ["heat_transfer_coefficient_w_m2k", "ambient_temperature_k"]},
        {"properties": {"type": {"const": "radiation"}, "emissivity": {"type": "number", "minimum": 0, "maximum": 1}, "radiation_temperature_k": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}}, "required": ["emissivity", "radiation_temperature_k"]},
        {"properties": {"type": {"const": "convection_radiation"}, "heat_transfer_coefficient_w_m2k": {"$ref": "#/$defs/positive"}, "ambient_temperature_k": {"$ref": "#/$defs/nonnegative"}, "emissivity": {"type": "number", "minimum": 0, "maximum": 1}, "radiation_temperature_k": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}}, "required": ["heat_transfer_coefficient_w_m2k", "ambient_temperature_k", "emissivity", "radiation_temperature_k"]}
      ],
      "unevaluatedProperties": false
    }
  }
}
