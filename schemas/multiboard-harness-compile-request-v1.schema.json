{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/multiboard-harness-compile-request-v1.schema.json",
  "title": "SPIKE multi-board harness compile request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "multiboard_request", "conductor_models"],
  "properties": {
    "contract": {"const": "spike/multiboard-harness-compile-request/v1"},
    "multiboard_request": {"$ref": "multiboard-analysis-request-v1.schema.json"},
    "conductor_models": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["harness_id", "conductors"],
        "properties": {
          "harness_id": {"type": "string", "minLength": 1},
          "conductors": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
