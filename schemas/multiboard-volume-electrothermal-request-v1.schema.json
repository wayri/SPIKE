{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/multiboard-volume-electrothermal-request-v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Original conservative reduced MNA / retained volume coupling. Semantic identity, topology and exhaustive loss validation also required.",
  "title": "SPIKE multiboard reduced circuit / volume thermal coupling",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "geometry", "thermal_problem", "circuit", "loss_bindings", "iteration", "loss_accounting"],
  "properties": {
    "contract": {"const": "spike/multiboard-volume-electrothermal-request/v1"},
    "geometry": {"allOf": [{"$ref": "assembly-field-handoff-request-v1.schema.json"}, {"properties": {"domain": {"const": "thermal"}}}]},
    "thermal_problem": {"allOf": [{"$ref": "assembly-field-thermal-problem-v1.schema.json"}, {"properties": {"heat_sources": {"maxItems": 0}}}]},
    "circuit": {"$ref": "multiboard-circuit-request-v1.schema.json"},
    "loss_accounting": {"const": "exhaustive_resistor_losses"},
    "thermal_engine": {"enum": ["internal", "calculix"]},
    "thermal_engine_options": {"type": "object", "additionalProperties": false, "properties": {
      "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 3300},
      "threads": {"type": "integer", "minimum": 1, "maximum": 32}
    }},
    "ac_heating": {"type": "object", "additionalProperties": false, "required": ["frequency_hz", "phasor_convention"], "properties": {
      "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
      "phasor_convention": {"enum": ["rms", "peak"]}
    }},
    "iteration": {"$ref": "assembly-electrothermal-request-v1.schema.json#/properties/iteration"},
    "loss_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false, "required": ["element_id", "distribution", "temperature_law"], "properties": {
        "element_id": {"$ref": "#/$defs/id"},
        "distribution": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {
          "type": "object", "additionalProperties": false, "required": ["occurrence_id", "cell_id", "weight"], "properties": {
            "occurrence_id": {"$ref": "#/$defs/id"}, "cell_id": {"$ref": "#/$defs/id"},
            "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        }},
        "temperature_law": {"type": "object", "additionalProperties": false, "required": ["temperature_coefficient_per_k", "reference_temperature_k", "temperature_range_k"], "properties": {
          "temperature_coefficient_per_k": {"type": "number"},
          "reference_temperature_k": {"type": "number", "exclusiveMinimum": 0},
          "temperature_range_k": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
        }}
      }
    }}
  },
  "allOf": [{"if": {"properties": {"circuit": {"properties": {"domain": {"const": "si"}}}}},
    "then": {"required": ["ac_heating"]}, "else": {"not": {"required": ["ac_heating"]}}}],
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}}
}
