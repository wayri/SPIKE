{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/solver-mesh-v1.schema.json",
  "title": "SPIKE Solver Mesh Interchange v1",
  "description": "Bounded solver-neutral mesh/artifact exchange. It preserves source-object ownership and units but does not assert mesh quality, convergence, or physical validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "units", "coordinate_system", "vertices", "cells", "object_map", "counts"],
  "properties": {
    "contract": {"const": "spike/solver-mesh/v1"},
    "units": {"enum": ["m", "mm"]},
    "coordinate_system": {"enum": ["right_handed_xyz"]},
    "vertices": {
      "type": "array", "maxItems": 10000000,
      "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
    },
    "cells": {
      "type": "array", "maxItems": 20000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "vertices", "source_object_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"enum": ["line", "triangle", "quad", "tetrahedron", "hexahedron"]},
          "vertices": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "integer", "minimum": 0}},
          "source_object_ids": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "material_id": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "object_map": {
      "type": "object", "maxProperties": 1000000,
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"type": "string", "minLength": 1}, "net": {"type": "string"}, "layer": {"type": "string"}}}
    },
    "counts": {"type": "object", "additionalProperties": false, "required": ["vertices", "cells"], "properties": {"vertices": {"type": "integer", "minimum": 0}, "cells": {"type": "integer", "minimum": 0}}}
  }
}
