{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/error-envelope-v1.schema.json",
  "title": "SPIKE Error Envelope v1",
  "description": "Canonical, user-safe diagnostic envelope for frontend and backend boundaries.",
  "type": "object",
  "required": [
    "contract",
    "code",
    "origin",
    "domain",
    "classification",
    "sequence",
    "title",
    "message",
    "recoverable",
    "retryable",
    "user_action",
    "docs_anchor",
    "timestamp_utc",
    "context"
  ],
  "properties": {
    "contract": { "const": "spike/error/v1" },
    "code": {
      "type": "string",
      "pattern": "^SPIKE-(FE|BE)-(APP|PROJECT|PACKAGE|IMPORT|VIEW|PI|SI|THERMAL|EMI|SPICE|SOLVER|MESH|PROBE|REPORT|EXT|IPC|SECURITY)-(I|W|P|E|C|S)-[0-9]{4}$"
    },
    "origin": { "enum": ["FE", "BE"] },
    "domain": {
      "enum": [
        "APP",
        "PROJECT",
        "PACKAGE",
        "IMPORT",
        "VIEW",
        "PI",
        "SI",
        "THERMAL",
        "EMI",
        "SPICE",
        "SOLVER",
        "MESH",
        "PROBE",
        "REPORT",
        "EXT",
        "IPC",
        "SECURITY"
      ]
    },
    "classification": { "enum": ["I", "W", "P", "E", "C", "S"] },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 },
    "detail": { "type": "string", "maxLength": 4096 },
    "recoverable": { "type": "boolean" },
    "retryable": { "type": "boolean" },
    "user_action": { "type": "string", "minLength": 1, "maxLength": 512 },
    "docs_anchor": {
      "type": "string",
      "pattern": "^help:error-codes#spike-(fe|be)-[a-z0-9-]+$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "cause_code": {
      "type": "string",
      "pattern": "^SPIKE-(FE|BE)-(APP|PROJECT|PACKAGE|IMPORT|VIEW|PI|SI|THERMAL|EMI|SPICE|SOLVER|MESH|PROBE|REPORT|EXT|IPC|SECURITY)-(I|W|P|E|C|S)-[0-9]{4}$"
    },
    "context": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "$ref": "#/$defs/contextValue" }
    }
  },
  "$defs": {
    "contextValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string", "maxLength": 1024 },
        {
          "type": "array",
          "maxItems": 65,
          "items": { "$ref": "#/$defs/contextValue" }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "$ref": "#/$defs/contextValue" }
        }
      ]
    }
  },
  "additionalProperties": false
}
