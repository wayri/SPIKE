{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/si-ami-execution-request/v1",
  "title": "Trusted local development AMI execution; not generic worker admission",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "platform", "direction", "model_file", "dependencies", "trust", "parameter_text", "sample_interval_s", "symbol_time_s", "impulse_response", "wave_blocks", "timeout_s", "memory_limit_mib"],
  "properties": {
    "contract": {"const": "spike/si-ami-execution-request/v1"},
    "platform": {"const": "windows-x86_64"},
    "direction": {"enum": ["tx", "rx"]},
    "model_file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[ -~]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dependencies": {"type": "array", "maxItems": 0},
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["acknowledgement", "license_reviewed", "dependency_reviewed"],
      "properties": {
        "acknowledgement": {"const": "trusted-native-code-with-current-user-access"},
        "license_reviewed": {"type": "boolean", "const": true},
        "dependency_reviewed": {"type": "boolean", "const": true}
      }
    },
    "parameter_text": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "sample_interval_s": {"type": "number", "exclusiveMinimum": 0},
    "symbol_time_s": {"type": "number", "exclusiveMinimum": 0},
    "impulse_response": {"$ref": "#/$defs/samples"},
    "wave_blocks": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/samples"}},
    "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "memory_limit_mib": {"type": "integer", "minimum": 32, "maximum": 2048}
  },
  "$defs": {"samples": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"type": "number"}}}
}
