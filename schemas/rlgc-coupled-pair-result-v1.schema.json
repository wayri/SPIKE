{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/rlgc-coupled-pair-result-v1.schema.json",
  "title": "SPIKE supplied symmetric coupled RLGC pair result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "source_request",
    "input_digest",
    "network",
    "modes",
    "points",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "spike/rlgc-coupled-pair-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "source_request": {
      "$ref": "rlgc-coupled-pair-request-v1.schema.json"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "port_names",
        "reference_impedance_ohm",
        "frequencies_hz",
        "s_parameters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "port_names": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequencies_hz": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "s_parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "real",
                  "imag"
                ],
                "properties": {
                  "real": {
                    "type": "number"
                  },
                  "imag": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "even",
        "odd"
      ],
      "properties": {
        "even": {
          "$ref": "rlgc-line-fields-result-v1.schema.json"
        },
        "odd": {
          "$ref": "rlgc-line-fields-result-v1.schema.json"
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frequency_hz",
          "boundary_values",
          "probe_values",
          "power_balance"
        ],
        "properties": {
          "frequency_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary_values": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port",
                "voltage_v",
                "current_into_line_a",
                "input_power_w"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "voltage_v": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "real",
                    "imag"
                  ],
                  "properties": {
                    "real": {
                      "type": "number"
                    },
                    "imag": {
                      "type": "number"
                    }
                  }
                },
                "current_into_line_a": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "real",
                    "imag"
                  ],
                  "properties": {
                    "real": {
                      "type": "number"
                    },
                    "imag": {
                      "type": "number"
                    }
                  }
                },
                "input_power_w": {
                  "type": "number"
                }
              }
            }
          },
          "probe_values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "fractional_position",
                "conductors",
                "pair"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "fractional_position": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "conductors": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "voltage_v",
                      "current_left_to_right_a",
                      "transported_power_w"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "\\S"
                      },
                      "voltage_v": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "real",
                          "imag"
                        ],
                        "properties": {
                          "real": {
                            "type": "number"
                          },
                          "imag": {
                            "type": "number"
                          }
                        }
                      },
                      "current_left_to_right_a": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "real",
                          "imag"
                        ],
                        "properties": {
                          "real": {
                            "type": "number"
                          },
                          "imag": {
                            "type": "number"
                          }
                        }
                      },
                      "transported_power_w": {
                        "type": "number"
                      }
                    }
                  }
                },
                "pair": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "electric_energy_j_per_m",
                    "magnetic_energy_j_per_m",
                    "conductor_loss_w_per_m",
                    "dielectric_loss_w_per_m",
                    "total_loss_w_per_m",
                    "transported_power_w"
                  ],
                  "properties": {
                    "electric_energy_j_per_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "magnetic_energy_j_per_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "conductor_loss_w_per_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "dielectric_loss_w_per_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "total_loss_w_per_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "transported_power_w": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "power_balance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conductor_loss_w",
              "dielectric_loss_w",
              "total_loss_w",
              "net_input_w",
              "residual_w",
              "wave_residual_w"
            ],
            "properties": {
              "conductor_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "dielectric_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "total_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "net_input_w": {
                "type": "number"
              },
              "residual_w": {
                "type": "number"
              },
              "wave_residual_w": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    }
  }
}
