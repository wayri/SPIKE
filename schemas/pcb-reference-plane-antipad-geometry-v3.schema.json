{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/pcb-reference-plane-antipad-geometry-v3.schema.json",
  "title": "SPIKE bounded-curve reference-plane antipad topology v3",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "source", "topology_policy", "regions", "topology_audit", "qualification"],
  "properties": {
    "contract": {"const": "spike/pcb-reference-plane-antipad-geometry/v3"},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["design_contract", "design_sha256", "via_geometry_contract", "via_geometry_sha256", "design_id", "via_id", "source_via_id"],
      "properties": {"design_contract": {"const": "spike/design-ir/v2"}, "design_sha256": {"$ref": "#/$defs/digest"},
        "via_geometry_contract": {"const": "spike/pcb-via-transition-geometry/v1"}, "via_geometry_sha256": {"$ref": "#/$defs/digest"},
        "design_id": {"$ref": "#/$defs/id"}, "via_id": {"$ref": "#/$defs/id"}, "source_via_id": {"type": "string", "maxLength": 256}}},
    "topology_policy": {"type": "object", "additionalProperties": false,
      "required": ["predicate", "coordinate_grid_mm", "curve_admission", "arc_subdivision", "maximum_sagitta_mm", "maximum_segment_length_mm", "maximum_segments_per_arc", "maximum_points_per_ring", "maximum_total_points", "grid_snap_bound_mm", "rounding_guard_grid_units"],
      "properties": {"predicate": {"const": "exact_integer_or_fail_closed"}, "coordinate_grid_mm": {"const": 0.000001},
        "curve_admission": {"const": "bounded_design_ir_line_and_circular_arc"},
        "arc_subdivision": {"const": "indexed_equal_angle_sagitta_and_length_bounded"},
        "maximum_sagitta_mm": {"const": 0.001}, "maximum_segment_length_mm": {"const": 0.25},
        "maximum_segments_per_arc": {"const": 4096}, "maximum_points_per_ring": {"const": 8192},
        "maximum_total_points": {"const": 16384}, "grid_snap_bound_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.000001},
        "rounding_guard_grid_units": {"const": 0.000001}}},
    "regions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/region"}},
    "topology_audit": {"type": "object", "additionalProperties": false,
      "required": ["complete_source_zones_captured", "simple_flattened_outer_rings", "existing_flattened_source_cutouts", "source_arcs", "flattened_segments", "explicit_antipad_holes", "strict_curve_envelope_separation_checked", "discrete_watertightness_checked"],
      "properties": {"complete_source_zones_captured": {"const": true}, "simple_flattened_outer_rings": {"type": "integer", "minimum": 1, "maximum": 64},
        "existing_flattened_source_cutouts": {"type": "integer", "minimum": 0, "maximum": 128},
        "source_arcs": {"type": "integer", "minimum": 0, "maximum": 16384},
        "flattened_segments": {"type": "integer", "minimum": 3, "maximum": 1048576},
        "explicit_antipad_holes": {"type": "integer", "minimum": 1, "maximum": 64},
        "strict_curve_envelope_separation_checked": {"const": true}, "discrete_watertightness_checked": {"const": false}}},
    "qualification": {"type": "object", "additionalProperties": false,
      "required": ["state", "source_curves_retained_in_design_ir", "conservative_copper_envelope_proven", "mesh_topology_admitted", "native_mesh_handoff_ready", "physics_convergence_performed", "capacitance_ready", "si_ready", "solver_ready"],
      "properties": {"state": {"const": "bounded_arc_flattened_topology_only"}, "source_curves_retained_in_design_ir": {"const": true},
        "conservative_copper_envelope_proven": {"const": false}, "mesh_topology_admitted": {"const": false},
        "native_mesh_handoff_ready": {"const": false}, "physics_convergence_performed": {"const": false},
        "capacitance_ready": {"const": false}, "si_ready": {"const": false}, "solver_ready": {"const": false}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "ring": {"type": "array", "minItems": 3, "maxItems": 8192, "items": {"$ref": "#/$defs/point"}},
    "sourceZone": {"type": "object", "additionalProperties": false,
      "required": ["zone_id", "source_zone_id", "net_id", "layer_id", "flattened_outer_ring_mm", "flattened_source_hole_rings_mm", "canonical_winding"],
      "properties": {"zone_id": {"$ref": "#/$defs/id"}, "source_zone_id": {"type": "string", "maxLength": 512}, "net_id": {"$ref": "#/$defs/id"},
        "layer_id": {"$ref": "#/$defs/id"}, "flattened_outer_ring_mm": {"$ref": "#/$defs/ring"},
        "flattened_source_hole_rings_mm": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/ring"}},
        "canonical_winding": {"const": "outer_ccw_cutouts_cw"}}},
    "antipad": {"type": "object", "additionalProperties": false,
      "required": ["antipad_id", "source_id", "center_mm", "radius_mm", "signal_clearance_mm"],
      "properties": {"antipad_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "center_mm": {"$ref": "#/$defs/point"},
        "radius_mm": {"type": "number", "exclusiveMinimum": 0}, "signal_clearance_mm": {"type": "number", "exclusiveMinimum": 0}}},
    "arcTessellation": {"type": "object", "additionalProperties": false,
      "required": ["ring_index", "segment_index", "emitted_segment_count", "directed_sweep_deg", "maximum_certified_deviation_mm"],
      "properties": {"ring_index": {"type": "integer", "minimum": 0, "maximum": 128},
        "segment_index": {"type": "integer", "minimum": 0, "maximum": 16383},
        "emitted_segment_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "directed_sweep_deg": {"type": "number", "exclusiveMinimum": -360, "exclusiveMaximum": 360, "not": {"const": 0}},
        "maximum_certified_deviation_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001}}},
    "curveTessellation": {"type": "object", "additionalProperties": false,
      "required": ["source_arc_count", "flattened_segment_count", "maximum_certified_curve_deviation_mm", "arc_tessellations"],
      "properties": {"source_arc_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "flattened_segment_count": {"type": "integer", "minimum": 3, "maximum": 16384},
        "maximum_certified_curve_deviation_mm": {"type": "number", "minimum": 0, "maximum": 0.001},
        "arc_tessellations": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/arcTessellation"}}}},
    "region": {"type": "object", "additionalProperties": false,
      "required": ["region_id", "source_zone", "antipad_holes", "z_min_mm", "z_max_mm", "source_boundary_sha256", "flattened_boundary_sha256", "curve_tessellation", "source_zone_sha256", "resolved_region_sha256", "exact_flattened_polygon_area_mm2", "analytic_flattened_resolved_area_mm2", "analytic_flattened_resolved_volume_mm3"],
      "properties": {"region_id": {"$ref": "#/$defs/id"}, "source_zone": {"$ref": "#/$defs/sourceZone"},
        "antipad_holes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/antipad"}},
        "z_min_mm": {"type": "number"}, "z_max_mm": {"type": "number"},
        "source_boundary_sha256": {"$ref": "#/$defs/digest"}, "flattened_boundary_sha256": {"$ref": "#/$defs/digest"},
        "curve_tessellation": {"$ref": "#/$defs/curveTessellation"}, "source_zone_sha256": {"$ref": "#/$defs/digest"},
        "resolved_region_sha256": {"$ref": "#/$defs/digest"}, "exact_flattened_polygon_area_mm2": {"type": "number", "exclusiveMinimum": 0},
        "analytic_flattened_resolved_area_mm2": {"type": "number", "exclusiveMinimum": 0},
        "analytic_flattened_resolved_volume_mm3": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
