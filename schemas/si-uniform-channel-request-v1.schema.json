{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/si-uniform-channel-request-v1.schema.json",
  "title": "SPIKE bounded uniform geometry-derived SI channel request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "signal_net", "reference_net", "reference_layer",
    "frequencies_hz", "reference_impedance_ohm"
  ],
  "properties": {
    "contract": {"const": "spike/si-uniform-channel-request/v1"},
    "channel_id": {"type": "string", "maxLength": 256},
    "signal_net": {"type": "string", "minLength": 1, "maxLength": 512},
    "victim_net": {"type": "string", "minLength": 1, "maxLength": 512},
    "crosstalk_model": {
      "type": "object", "additionalProperties": false,
      "required": ["port_map", "termination_ohm"],
      "properties": {
        "port_map": {
          "type": "object", "additionalProperties": false,
          "required": ["aggressor_near", "aggressor_far", "victim_near", "victim_far"],
          "properties": {
            "aggressor_near": {"type": "integer", "minimum": 0, "maximum": 3},
            "aggressor_far": {"type": "integer", "minimum": 0, "maximum": 3},
            "victim_near": {"type": "integer", "minimum": 0, "maximum": 3},
            "victim_far": {"type": "integer", "minimum": 0, "maximum": 3}
          }
        },
        "termination_ohm": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "number", "minimum": 0.000001, "maximum": 1000000000000}
        },
        "waveform_v": {
          "type": ["array", "null"], "minItems": 2, "maxItems": 65536,
          "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}
        },
        "trace_limit": {"type": "integer", "minimum": 16, "maximum": 16384}
      }
    },
    "reference_net": {"type": "string", "minLength": 1, "maxLength": 512},
    "reference_layer": {"type": "string", "minLength": 1, "maxLength": 512},
    "path_id": {"type": "string", "maxLength": 512},
    "victim_path_id": {"type": "string", "maxLength": 512},
    "path_mode": {"enum": ["strict_uniform", "piecewise_planar"], "default": "strict_uniform"},
    "signaling": {"enum": ["single_ended", "differential"], "default": "single_ended"},
    "cross_section_vertical_cells": {"type": "integer", "minimum": 12, "maximum": 96},
    "coupled_separation_tolerance_mm": {"type": "number", "minimum": 0, "maximum": 1000},
    "coupled_skew_tolerance_mm": {"type": "number", "minimum": 0, "maximum": 1000},
    "reference_impedance_ohm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "frequencies_hz": {
      "type": "array", "minItems": 3, "maxItems": 32769,
      "items": {"type": "number", "minimum": 0, "maximum": 1000000000000}
    },
    "bit_rate_hz": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
    "bit_count": {"type": "integer", "minimum": 128, "maximum": 8192},
    "symbol_rate_hz": {"type": "number", "minimum": 1, "maximum": 1000000000000},
    "symbol_count": {"type": "integer", "minimum": 256, "maximum": 4096},
    "pam4_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tx_ffe_taps": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {"type": "number"}
        },
        "rx_ctle_dc_gain": {"type": "number", "minimum": 0.000001, "maximum": 1000000},
        "rx_ctle_zero_hz": {"type": "number", "minimum": 0, "maximum": 10000000000000},
        "rx_ctle_pole_hz": {"type": "number", "minimum": 0, "maximum": 10000000000000},
        "rx_dfe_taps": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {"type": "number"}
        },
        "voltage_noise_rms_normalized": {"type": "number", "minimum": 0, "maximum": 10},
        "phase_bins": {"type": "integer", "minimum": 17, "maximum": 129, "not": {"multipleOf": 2}},
        "target_ber": {"type": "number", "minimum": 1e-18, "maximum": 0.49},
        "cdr_mode": {"enum": ["fixed_center", "ideal_phase_search"]}
      }
    },
    "statistical_eye_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voltage_noise_rms_normalized": {"type": "number", "minimum": 0, "maximum": 10},
        "random_jitter_rms_s": {"type": "number", "minimum": 0},
        "deterministic_jitter_pp_s": {"type": "number", "minimum": 0},
        "decision_threshold_normalized": {"type": "number", "minimum": -10, "maximum": 10},
        "phase_bins": {"type": "integer", "minimum": 17, "maximum": 129, "not": {"multipleOf": 2}},
        "target_ber": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5}
      }
    },
    "trace_limit": {"type": "integer", "minimum": 2, "maximum": 32769}
  },
  "allOf": [{"if": {"required": ["crosstalk_model"]},
    "then": {"required": ["victim_net"], "properties": {"frequencies_hz": {"maxItems": 8193}}}}]
}
