{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/pwm-electrothermal-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "status",
    "model_status",
    "checkpoint",
    "restart",
    "issue_codes",
    "parameters",
    "windows",
    "energy",
    "request_sha256",
    "configuration_sha256",
    "runtime",
    "quality",
    "limits"
  ],
  "properties": {
    "contract": {
      "const": "spike/pwm-electrothermal-result/v1"
    },
    "status": {
      "enum": [
        "completed",
        "cancelled"
      ]
    },
    "model_status": {
      "const": "experimental"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "completed_cycles",
        "configuration_sha256",
        "library_sha256",
        "state_sha256"
      ],
      "properties": {
        "contract": {
          "const": "spike/pwm-electrothermal-checkpoint/v1"
        },
        "completed_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "library_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "verified",
        "no_replay_speedup_claim"
      ],
      "properties": {
        "method": {
          "const": "deterministic_replay"
        },
        "verified": {
          "type": "boolean"
        },
        "no_replay_speedup_claim": {
          "const": true
        }
      }
    },
    "issue_codes": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "const": "PWM_CANCELLED"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_voltage_v",
        "target_voltage_v",
        "inductance_h",
        "capacitance_f",
        "load_resistance_ohm",
        "winding_resistance_ohm",
        "temperature_coefficient_per_k",
        "ambient_temperature_k",
        "thermal_resistance_k_per_w",
        "thermal_capacitance_j_per_k",
        "switch_on_resistance_ohm",
        "switch_off_resistance_ohm",
        "switching_frequency_hz",
        "maximum_step_s",
