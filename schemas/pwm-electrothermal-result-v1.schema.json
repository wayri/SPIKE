      ],
      "properties": {
        "input_voltage_v": {
          "type": "number"
        },
        "target_voltage_v": {
          "type": "number"
        },
        "inductance_h": {
          "type": "number"
        },
        "capacitance_f": {
          "type": "number"
        },
        "load_resistance_ohm": {
          "type": "number"
        },
        "winding_resistance_ohm": {
          "type": "number"
        },
        "temperature_coefficient_per_k": {
          "type": "number"
        },
        "ambient_temperature_k": {
          "type": "number"
        },
        "thermal_resistance_k_per_w": {
          "type": "number"
        },
        "thermal_capacitance_j_per_k": {
          "type": "number"
        },
        "switch_on_resistance_ohm": {
          "type": "number"
        },
        "switch_off_resistance_ohm": {
          "type": "number"
        },
        "switching_frequency_hz": {
          "type": "number"
        },
        "maximum_step_s": {
          "type": "number"
        },
        "controller_kp_per_v": {
          "type": "number"
        },
        "controller_ki_per_v_s": {
          "type": "number"
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    },
    "windows": {
      "type": "array",
      "maxItems": 2000,
