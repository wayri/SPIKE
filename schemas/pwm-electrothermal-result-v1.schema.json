              "switch_j",
              "load_j",
              "winding_j",
              "ambient_j",
              "be_numerical_dissipation_j"
            ],
            "properties": {
              "source_j": {
                "type": "number"
              },
              "switch_j": {
                "type": "number"
              },
              "load_j": {
                "type": "number"
              },
              "winding_j": {
                "type": "number"
              },
              "ambient_j": {
                "type": "number"
              },
              "be_numerical_dissipation_j": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_j",
        "switch_j",
        "load_j",
        "winding_j",
        "ambient_j",
        "be_numerical_dissipation_j",
        "electrical_stored_j",
        "thermal_stored_j",
        "electrical_balance_j",
        "thermal_balance_j"
      ],
      "properties": {
        "source_j": {
          "type": "number"
        },
        "switch_j": {
          "type": "number"
        },
        "load_j": {
          "type": "number"
        },
        "winding_j": {
          "type": "number"
        },
        "ambient_j": {
          "type": "number"
        },
        "be_numerical_dissipation_j": {
          "type": "number"
        },
        "electrical_stored_j": {
          "type": "number"
        },
        "thermal_stored_j": {
          "type": "number"
        },
        "electrical_balance_j": {
          "type": "number"
        },
        "thermal_balance_j": {
          "type": "number"
        }
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "integration",
        "diagnostics",
        "library_sha256"
      ],
      "properties": {
        "engine": {
          "const": "native_spikes_persistent_mna"
        },
        "integration": {
          "const": "backward_euler"
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completed_steps": {
              "type": "number"
            },
            "matrix_factorizations": {
              "type": "number"
            },
            "total_newton_iterations": {
              "type": "number"
            },
            "residual_inf_norm": {
              "type": "number"
            },
            "factorization_reuses": {
              "type": "number"
            },
            "factorization_cache_entries": {
              "type": "number"
            },
            "backward_euler_steps": {
              "type": "number"
            },
            "trapezoidal_steps": {
              "type": "number"
            },
