{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/pcb-reference-plane-antipad-geometry-v1.schema.json",
  "title": "SPIKE complete source reference-plane geometry with explicit antipad v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "source", "regions", "topology_audit", "qualification"],
  "properties": {
    "contract": {"const": "spike/pcb-reference-plane-antipad-geometry/v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["design_contract", "design_sha256", "via_geometry_contract", "via_geometry_sha256", "design_id", "via_id", "source_via_id"],
      "properties": {
        "design_contract": {"const": "spike/design-ir/v2"}, "design_sha256": {"$ref": "#/$defs/digest"},
        "via_geometry_contract": {"const": "spike/pcb-via-transition-geometry/v1"},
        "via_geometry_sha256": {"$ref": "#/$defs/digest"}, "design_id": {"$ref": "#/$defs/id"},
        "via_id": {"$ref": "#/$defs/id"}, "source_via_id": {"type": "string", "maxLength": 256}
      }
    },
    "regions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/region"}},
    "topology_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["complete_source_zones_captured", "strictly_convex_source_zones", "existing_source_holes", "explicit_antipad_holes", "discrete_watertightness_checked"],
      "properties": {
        "complete_source_zones_captured": {"const": true}, "strictly_convex_source_zones": {"const": true},
        "existing_source_holes": {"const": 0}, "explicit_antipad_holes": {"type": "integer", "minimum": 1, "maximum": 64},
        "discrete_watertightness_checked": {"const": false}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "native_handoff_ready", "physics_convergence_performed", "capacitance_ready", "si_ready", "solver_ready"],
      "properties": {
        "state": {"const": "exact_full_source_zone_minus_explicit_antipad"},
        "native_handoff_ready": {"const": false}, "physics_convergence_performed": {"const": false},
        "capacitance_ready": {"const": false}, "si_ready": {"const": false}, "solver_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "ring": {"type": "array", "minItems": 3, "maxItems": 4096, "items": {"$ref": "#/$defs/point"}},
    "sourceZone": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "source_zone_id", "net_id", "layer_id", "outer_ring_mm", "source_hole_rings_mm"],
      "properties": {
        "zone_id": {"$ref": "#/$defs/id"}, "source_zone_id": {"type": "string", "maxLength": 512},
        "net_id": {"$ref": "#/$defs/id"}, "layer_id": {"$ref": "#/$defs/id"},
        "outer_ring_mm": {"$ref": "#/$defs/ring"},
        "source_hole_rings_mm": {"type": "array", "maxItems": 0}
      }
    },
    "antipadHole": {
      "type": "object", "additionalProperties": false,
      "required": ["antipad_id", "source_id", "center_mm", "radius_mm", "signal_clearance_mm"],
      "properties": {
        "antipad_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"},
        "center_mm": {"$ref": "#/$defs/point"}, "radius_mm": {"type": "number", "exclusiveMinimum": 0},
        "signal_clearance_mm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "source_zone", "antipad_holes", "z_min_mm", "z_max_mm", "source_zone_sha256", "resolved_region_sha256", "minimum_antipad_to_outer_boundary_mm", "exact_area_mm2", "exact_volume_mm3"],
      "properties": {
        "region_id": {"$ref": "#/$defs/id"}, "source_zone": {"$ref": "#/$defs/sourceZone"},
        "antipad_holes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/antipadHole"}},
        "z_min_mm": {"type": "number"}, "z_max_mm": {"type": "number"},
        "source_zone_sha256": {"$ref": "#/$defs/digest"}, "resolved_region_sha256": {"$ref": "#/$defs/digest"},
        "minimum_antipad_to_outer_boundary_mm": {"type": "number", "exclusiveMinimum": 0},
        "exact_area_mm2": {"type": "number", "exclusiveMinimum": 0},
        "exact_volume_mm3": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
