{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/headless-workflow-v1.schema.json",
  "title": "SPIKE headless workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "steps"],
  "properties": {
    "contract": {"const": "spike/headless-workflow/v1"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "method", "params"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[^#]+$"},
          "method": {"type": "string", "pattern": "\\S"},
          "params": {"type": "object"}
        }
      }
    }
  }
}
