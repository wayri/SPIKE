{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "input_digest",
    "source",
    "dc_policy",
    "interpolation_method",
    "derived_network",
    "diagnostics",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "spike/sparameter-resampling-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_digest",
        "network"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "port_names",
            "reference_impedance_ohm",
            "frequencies_hz",
            "s_parameters"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "port_names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "reference_impedance_ohm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "frequencies_hz": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "s_parameters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "real",
                      "imag"
                    ],
                    "properties": {
                      "real": {
                        "type": "number"
                      },
                      "imag": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dc_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "require_source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "s_parameters"
          ],
          "properties": {
            "mode": {
              "const": "supplied"
            },
            "s_parameters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "real",
                    "imag"
                  ],
                  "properties": {
                    "real": {
                      "type": "number"
                    },
                    "imag": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "interpolation_method": {
      "const": "cartesian_linear"
    },
    "derived_network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "port_names",
        "reference_impedance_ohm",
        "frequencies_hz",
        "s_parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "port_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frequencies_hz": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "s_parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "real",
                  "imag"
                ],
                "properties": {
                  "real": {
                    "type": "number"
                  },
                  "imag": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frequency_hz",
          "kind",
          "lower_frequency_hz",
          "upper_frequency_hz",
          "weight_upper",
          "smax"
        ],
        "properties": {
          "frequency_hz": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "source_sample",
              "supplied_dc",
              "linear_interpolation"
            ]
          },
          "lower_frequency_hz": {
            "type": "number",
            "minimum": 0
          },
          "upper_frequency_hz": {
            "type": "number",
            "minimum": 0
          },
          "weight_upper": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "smax": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/sparameter-resampling-result/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0; exact source identity, interpolation mapping and finite results additionally enforced by runtime. No causality qualification."
}
