{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/si-protocol-test-suite-request-v1.schema.json",
  "title": "SPIKE SI protocol test-suite request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "suite", "lanes"],
  "properties": {
    "contract": {"const": "spike/si-protocol-test-suite-request/v1"},
    "suite": {"$ref": "si-protocol-suite-v1.schema.json"},
    "lanes": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane_id", "channel_request"],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "channel_request": {"$ref": "si-uniform-channel-request-v1.schema.json"}
        }
      }
    },
    "requested_tests": {
      "type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true,
      "items": {"enum": ["topology", "impedance", "rlgc", "s_parameters", "tdr_tdt", "insertion_return_loss", "next_fext", "mode_conversion", "skew_delay", "eye", "jitter", "pam4", "power_aware", "compliance_review"]}
    },
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maximum_lanes": {"type": "integer", "minimum": 1, "maximum": 32},
        "maximum_frequency_points": {"type": "integer", "minimum": 1, "maximum": 131076},
        "maximum_estimated_numeric_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728}
      }
    }
  }
}
