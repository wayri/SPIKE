{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/harness-round-wire-rlgc/v1",
  "title": "Bounded straight solid round-wire image-plane RLGC extraction",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "wires", "dielectric", "frequency_hz", "reference_plane", "provenance"],
  "properties": {
    "contract": {"const": "spike/harness-round-wire-rlgc/v1"},
    "harness_id": {"$ref": "#/$defs/id"}, "occurrence_id": {"$ref": "#/$defs/id"},
    "wires": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/wire"}},
    "frequency_hz": {"type": "array", "minItems": 1, "maxItems": 257, "items": {"type": "number", "minimum": 0, "maximum": 10000000000}},
    "dielectric": {"type": "object", "additionalProperties": false, "required": ["relative_permittivity", "loss_tangent"], "properties": {"relative_permittivity": {"type": "number", "minimum": 1, "maximum": 100}, "loss_tangent": {"type": "number", "minimum": 0, "maximum": 0.1}}},
    "reference_plane": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/id"}}},
    "provenance": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "wire": {
      "type": "object", "additionalProperties": false,
      "required": ["wire_id", "x_m", "height_m", "radius_m", "conductivity_s_m", "relative_permeability"],
      "properties": {
        "wire_id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"}, "occurrence_id": {"$ref": "#/$defs/id"},
        "x_m": {"type": "number", "minimum": -100, "maximum": 100},
        "height_m": {"type": "number", "minimum": 0.000001, "maximum": 100},
        "radius_m": {"type": "number", "minimum": 0.0000001, "maximum": 0.1},
        "conductivity_s_m": {"type": "number", "minimum": 10000, "maximum": 1000000000},
        "relative_permeability": {"type": "number", "minimum": 0.001, "maximum": 10000}
      }
    }
  }
}
