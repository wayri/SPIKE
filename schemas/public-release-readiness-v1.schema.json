{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/public-release-readiness-v1.schema.json",
  "title": "SPIKES public release readiness report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "product", "version", "status", "public_distribution_authorized", "technical_candidate", "checks", "failures", "external_blockers", "claim_boundary"],
  "properties": {
    "contract": {"const": "spike/public-release-readiness/v1"},
    "product": {"const": "SPIKES circuit engine and SDK"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["PASS", "BLOCKED_EXTERNAL", "FAIL"]},
    "public_distribution_authorized": {"type": "boolean"},
    "technical_candidate": {"type": "boolean"},
    "checks": {"type": "object", "additionalProperties": {"type": "object"}},
    "failures": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 4096}},
    "external_blockers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "owner_action"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 128},
          "owner_action": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": {"const": false}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "public_distribution_authorized": {"const": true},
          "technical_candidate": {"const": true},
          "failures": {"maxItems": 0},
          "external_blockers": {"maxItems": 0}
        }
      }
    }
  ]
}
