{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/multiboard-si-independent-batch-request-v1.schema.json",
  "title": "SPIKE independent multi-board SI batch request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "multiboard_request", "jobs"],
  "properties": {
    "contract": {"const": "spike/multiboard-si-independent-batch-request/v1"},
    "multiboard_request": {"$ref": "multiboard-analysis-request-v1.schema.json"},
    "jobs": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["board_id", "suite_request"],
        "properties": {
          "board_id": {"type": "string", "minLength": 1},
          "suite_request": {"$ref": "si-protocol-test-suite-request-v1.schema.json"}
        }
      }
    },
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maximum_board_jobs": {"type": "integer", "minimum": 1, "maximum": 30},
        "maximum_total_lanes": {"type": "integer", "minimum": 1, "maximum": 256},
        "maximum_total_frequency_points": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximum_total_estimated_numeric_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
