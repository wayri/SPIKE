        "padstack_ref": { "$ref": "#/$defs/id" }, "primitive_ref": { "$ref": "#/$defs/id" }, "declared_regular_layer_id": { "$ref": "#/$defs/id" }, "observed_layer_id": { "$ref": "#/$defs/id" }, "declared_layer_matches_observed": { "type": "boolean" }, "raw_observed_layer_ref": { "$ref": "#/$defs/id" }, "observed_layer_polarity": { "const": "positive" }, "raw_net_ref": { "$ref": "#/$defs/id" }, "resolved_net_id": { "$ref": "#/$defs/id" }, "pin_provenance": { "$ref": "#/$defs/retainedStandardContourLandPinProvenance" }, "at_mm": { "$ref": "#/$defs/point" }, "xform": { "$ref": "#/$defs/retainedStandardContourLandXform" }, "raw_primitive_ref_attributes": { "$ref": "#/$defs/stringMap" }, "raw_pad_attributes": { "$ref": "#/$defs/stringMap" }, "raw_set_attributes": { "$ref": "#/$defs/stringMap" }, "raw_layer_feature_attributes": { "$ref": "#/$defs/stringMap" }
      }, "additionalProperties": false
