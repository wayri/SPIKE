      "properties": {
        "name": { "$ref": "#/$defs/id" }, "source_index": { "type": "integer", "minimum": 0 }, "raw_attributes": { "$ref": "#/$defs/stringMap" },
        "declared_regular_layer_id": { "$ref": "#/$defs/id" }, "raw_declared_regular_layer_ref": { "$ref": "#/$defs/id" }, "raw_profile_attributes": { "$ref": "#/$defs/stringMap" },
        "profile_location": { "$ref": "#/$defs/retainedStandardContourLandLocation" }, "profile_xform": { "$ref": "#/$defs/retainedStandardContourLandXform" },
        "primitive_ref": { "$ref": "#/$defs/id" }, "raw_primitive_ref_attributes": { "$ref": "#/$defs/stringMap" }
