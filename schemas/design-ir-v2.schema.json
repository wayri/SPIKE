    "stringMap": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 4096 }, "propertyNames": { "minLength": 1, "maxLength": 128 } },
    "drill": {
      "allOf": [{ "$ref": "#/$defs/entity" }, {
        "type": "object",
