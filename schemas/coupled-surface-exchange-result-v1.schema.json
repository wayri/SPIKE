{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/coupled-surface-exchange-result-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "transfer_id", "context_digest", "request_digest", "quantity", "status", "production_qualified", "normal_relation", "sign_convention", "destination_integrated_values", "diagnostics", "limitations"],
  "dependentRequired": {"mapped_source_values": ["mapped_source_value_unit"], "mapped_source_value_unit": ["mapped_source_values"]},
  "properties": {
    "contract": {"const": "spike/coupled-surface-exchange-result/v1"},
    "transfer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "context_digest": {"$ref": "#/$defs/digest"}, "request_digest": {"$ref": "#/$defs/digest"},
    "quantity": {"enum": ["heat_flux", "traction"]}, "status": {"const": "experimental"}, "production_qualified": {"const": false},
    "normal_relation": {"const": "opposite_outward_normals"}, "sign_convention": {"type": "string", "maxLength": 256},
    "destination_integrated_values": {"$ref": "#/$defs/values"}, "mapped_source_values": {"$ref": "#/$defs/values"},
    "mapped_source_value_unit": {"enum": ["K", "m", "m/s"]},
    "diagnostics": {"type": "object", "additionalProperties": false,
      "required": ["source_outward_integrated_total", "destination_outward_integrated_total", "raw_global_balance", "maximum_absolute_balance", "coverage"],
      "properties": {"source_outward_integrated_total": {"$ref": "#/$defs/value"}, "destination_outward_integrated_total": {"$ref": "#/$defs/value"}, "raw_global_balance": {"$ref": "#/$defs/value"}, "maximum_absolute_balance": {"type": "number", "minimum": 0},
        "coverage": {"type": "object", "additionalProperties": false,
          "required": ["source_area_m2", "destination_area_m2", "overlap_area_m2", "source_maximum_absolute_defect_m2", "destination_maximum_absolute_defect_m2"],
          "patternProperties": {"^(source_area_m2|destination_area_m2|overlap_area_m2|source_maximum_absolute_defect_m2|destination_maximum_absolute_defect_m2)$": {"type": "number", "minimum": 0}}},
        "adjoint_pairing": {"type": "object", "additionalProperties": false,
          "required": ["kind", "unit", "source_pairing", "destination_pairing", "raw_pairing_balance", "absolute_pairing_defect"],
          "properties": {"kind": {"enum": ["thermal_bilinear_duality_not_physical_work", "virtual_power", "virtual_work"]}, "unit": {"enum": ["W*K", "W", "J"]}, "source_pairing": {"type": "number"}, "destination_pairing": {"type": "number"}, "raw_pairing_balance": {"type": "number"}, "absolute_pairing_defect": {"type": "number", "minimum": 0}}}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "value": {"oneOf": [{"type": "number"}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}]},
    "values": {"type": "array", "minItems": 1, "maxItems": 511,
      "items": {"type": "object", "additionalProperties": false, "required": ["face_id", "value"],
        "properties": {"face_id": {"type": "string", "minLength": 1, "maxLength": 256}, "value": {"$ref": "#/$defs/value"}}}}
  }
}
