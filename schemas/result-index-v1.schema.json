{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/result-index-v1.schema.json",
  "title": "SPIKE result index v1",
  "type": "object",
  "required": ["contract", "runs"],
  "properties": {
    "contract": {"const": "spike/result-index/v1"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "design_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "design_id": {"type": "string", "minLength": 1},
          "result": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
