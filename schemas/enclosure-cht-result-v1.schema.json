{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/enclosure-cht-result-v1.schema.json",
  "title": "Experimental closed 3-D enclosure conjugate sensible heat result",
  "oneOf": [{"$ref": "#/$defs/completed"}, {"$ref": "#/$defs/unsuccessful"}],
  "$defs": {
    "identity": {
      "type": "object", "required": ["contract", "status", "model_status", "production_qualified"],
      "properties": {
        "contract": {"const": "spike/enclosure-cht-result/v1"},
        "status": {"enum": ["completed", "blocked", "cancelled"]},
        "model_status": {"const": "experimental"}, "production_qualified": {"const": false}
      }
    },
    "completed": {
      "allOf": [{"$ref": "#/$defs/identity"}, {
        "if": {"properties": {"energy_diagnostics": {"properties": {"time_s": {"type": "null"}}}}},
        "then": {"properties": {
          "history": {"maxItems": 1, "items": {"properties": {"time_s": {"type": "null"}}}},
          "temperature_frames": {"maxItems": 0}
        }},
        "else": {"properties": {
          "history": {"items": {"properties": {"time_s": {"type": "number"}}}},
          "temperature_frames": {"minItems": 1}
        }}
      }], "type": "object", "unevaluatedProperties": false,
      "required": ["request_sha256", "grid", "fields", "flow_diagnostics", "transfer_diagnostics", "energy_diagnostics", "history", "temperature_frames", "interfaces", "limitations"],
      "properties": {
        "status": {"const": "completed"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grid": {
          "type": "object", "additionalProperties": false,
          "required": ["axes_m", "shape", "coarse_shape", "momentum_locally_refined", "thermal_refinement"],
          "properties": {
            "axes_m": {"type": "array", "minItems": 3, "maxItems": 3,
              "items": {"type": "array", "minItems": 2, "maxItems": 65, "items": {"type": "number"}}},
            "shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 64}},
            "coarse_shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 32}},
            "momentum_locally_refined": {"const": false}, "thermal_refinement": {"const": "nested_tensor_planes"}
          }
        },
        "fields": {
          "type": "object", "additionalProperties": false,
          "required": ["temperature_k", "material_ids", "face_velocity_m_s", "coarse_gauge_pressure_pa"],
          "properties": {
            "temperature_k": {"$ref": "#/$defs/temperatures"},
            "material_ids": {"type": "array", "minItems": 1, "maxItems": 64,
              "items": {"type": "array", "minItems": 1, "maxItems": 64,
                "items": {"type": "array", "minItems": 1, "maxItems": 64,
                  "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}}}},
            "face_velocity_m_s": {"type": "array", "minItems": 3, "maxItems": 3,
              "prefixItems": [{"$ref": "#/$defs/xFaces"}, {"$ref": "#/$defs/yFaces"}, {"$ref": "#/$defs/zFaces"}], "items": false},
            "coarse_gauge_pressure_pa": {"type": "array", "minItems": 1, "maxItems": 32,
              "items": {"type": "array", "minItems": 1, "maxItems": 32,
                "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "number"}}}}
          }
        },
        "flow_diagnostics": {"oneOf": [{"$ref": "#/$defs/creepingDiagnostics"}, {"$ref": "#/$defs/inertialDiagnostics"}]},
        "transfer_diagnostics": {"$ref": "#/$defs/transferDiagnostics"},
        "energy_diagnostics": {"$ref": "#/$defs/energyDiagnostics"},
        "history": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/history"}},
        "temperature_frames": {"type": "array", "maxItems": 256,
          "items": {"type": "object", "additionalProperties": false, "required": ["time_s", "temperature_k"],
            "properties": {"time_s": {"type": "number", "exclusiveMinimum": 0}, "temperature_k": {"$ref": "#/$defs/temperatures"}}}},
        "interfaces": {"type": "array", "maxItems": 24576,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cell_p", "cell_n", "area_m2", "heat_p_to_n_w", "temperature_k"],
            "properties": {
              "cell_p": {"type": "integer", "minimum": 0, "maximum": 8191},
              "cell_n": {"type": "integer", "minimum": 0, "maximum": 8191},
              "area_m2": {"type": "number", "exclusiveMinimum": 0},
              "heat_p_to_n_w": {"type": "number"},
              "temperature_k": {"type": "number", "exclusiveMinimum": 0}
            }
          }},
        "limitations": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "minLength": 1}}
      }
    },
    "unsuccessful": {
      "allOf": [{"$ref": "#/$defs/identity"}], "type": "object", "unevaluatedProperties": false,
      "required": ["issues"],
      "properties": {
        "status": {"enum": ["blocked", "cancelled"]},
        "flow_diagnostics": {"type": "null"},
        "issues": {"type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}}}}
      }
    },
    "nonnegative": {"type": "number", "minimum": 0},
    "temperatures": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "array", "minItems": 1, "maxItems": 64,
        "items": {"type": "array", "minItems": 1, "maxItems": 64,
          "items": {"type": "number", "exclusiveMinimum": 0}}}},
    "xFaces": {"type": "array", "minItems": 2, "maxItems": 65,
      "items": {"type": "array", "minItems": 1, "maxItems": 64,
        "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}}}},
    "yFaces": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "array", "minItems": 2, "maxItems": 65,
        "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}}}},
    "zFaces": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "array", "minItems": 1, "maxItems": 64,
        "items": {"type": "array", "minItems": 2, "maxItems": 65, "items": {"type": "number"}}}},
    "flowBase": {
      "type": "object",
      "required": ["momentum_relative_residual", "maximum_divergence_s_inv", "reynolds_upper_bound", "force_work_w", "viscous_dissipation_w", "fluid_cells", "velocity_unknowns", "fluid_components"],
      "properties": {
        "momentum_relative_residual": {"$ref": "#/$defs/nonnegative"},
        "maximum_divergence_s_inv": {"$ref": "#/$defs/nonnegative"},
        "reynolds_upper_bound": {"$ref": "#/$defs/nonnegative"},
        "force_work_w": {"type": "number"}, "viscous_dissipation_w": {"$ref": "#/$defs/nonnegative"},
        "fluid_cells": {"type": "integer", "minimum": 1, "maximum": 4096},
        "velocity_unknowns": {"type": "integer", "minimum": 0, "maximum": 12288},
        "fluid_components": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "creepingDiagnostics": {
      "allOf": [{"$ref": "#/$defs/flowBase"}], "type": "object", "unevaluatedProperties": false,
      "properties": {"reynolds_upper_bound": {"type": "number", "minimum": 0, "maximum": 0.1}}
    },
    "inertialDiagnostics": {
      "allOf": [{"$ref": "#/$defs/flowBase"}], "type": "object", "unevaluatedProperties": false,
      "required": ["advective_power_w", "pressure_power_w", "relative_energy_defect", "iterations", "momentum_residual_history", "thermal_grid_fluid_box_indices"],
      "properties": {
        "reynolds_upper_bound": {"type": "number", "minimum": 0, "maximum": 20},
        "fluid_components": {"const": 1},
        "advective_power_w": {"type": "number"}, "pressure_power_w": {"type": "number"},
        "relative_energy_defect": {"$ref": "#/$defs/nonnegative"},
        "iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "momentum_residual_history": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/nonnegative"}},
        "thermal_grid_fluid_box_indices": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 32}}}
      }
    },
    "transferDiagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_coarse_divergence_s_inv", "maximum_fine_divergence_s_inv", "maximum_divergence_difference_s_inv", "divergence_scale_s_inv", "maximum_divergence_difference_relative", "coarse_face_flux_integral_absolute_error_m3_s", "maximum_coarse_face_flux_integral_error_m3_s", "coarse_face_flux_integral_scale_m3_s", "coarse_face_flux_integral_relative_error", "zero_coarse_face_patches", "zero_coarse_face_preservation_error_m_s"],
      "properties": {
        "maximum_coarse_divergence_s_inv": {"$ref": "#/$defs/nonnegative"},
        "maximum_fine_divergence_s_inv": {"$ref": "#/$defs/nonnegative"},
        "maximum_divergence_difference_s_inv": {"$ref": "#/$defs/nonnegative"},
        "divergence_scale_s_inv": {"$ref": "#/$defs/nonnegative"},
        "maximum_divergence_difference_relative": {"$ref": "#/$defs/nonnegative"},
        "coarse_face_flux_integral_absolute_error_m3_s": {"$ref": "#/$defs/nonnegative"},
        "maximum_coarse_face_flux_integral_error_m3_s": {"$ref": "#/$defs/nonnegative"},
        "coarse_face_flux_integral_scale_m3_s": {"$ref": "#/$defs/nonnegative"},
        "coarse_face_flux_integral_relative_error": {"$ref": "#/$defs/nonnegative"},
        "zero_coarse_face_patches": {"type": "integer", "minimum": 0, "maximum": 24576},
        "zero_coarse_face_preservation_error_m_s": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "outwardHeat": {
      "type": "object", "additionalProperties": false, "required": ["x_min", "x_max", "y_min", "y_max", "z_min", "z_max"],
      "properties": {
        "x_min": {"type": "number"}, "x_max": {"type": "number"}, "y_min": {"type": "number"},
        "y_max": {"type": "number"}, "z_min": {"type": "number"}, "z_max": {"type": "number"}
      }
    },
    "historyBase": {
      "type": "object",
      "required": ["time_s", "generated_heat_w", "outward_heat_w", "stored_energy_rate_w", "raw_energy_balance_w", "relative_energy_balance", "row_scaled_residual_k", "minimum_temperature_k", "maximum_temperature_k", "interface_signed_heat_w", "interface_absolute_heat_w", "maximum_interface_temperature_jump_k"],
      "properties": {
        "time_s": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "generated_heat_w": {"type": "number"}, "outward_heat_w": {"$ref": "#/$defs/outwardHeat"},
        "stored_energy_rate_w": {"type": "number"}, "raw_energy_balance_w": {"type": "number"},
        "relative_energy_balance": {"$ref": "#/$defs/nonnegative"}, "row_scaled_residual_k": {"$ref": "#/$defs/nonnegative"},
        "minimum_temperature_k": {"type": "number", "exclusiveMinimum": 0},
        "maximum_temperature_k": {"type": "number", "exclusiveMinimum": 0},
        "interface_signed_heat_w": {"type": "number"}, "interface_absolute_heat_w": {"$ref": "#/$defs/nonnegative"},
        "maximum_interface_temperature_jump_k": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "history": {"allOf": [{"$ref": "#/$defs/historyBase"}], "unevaluatedProperties": false},
    "energyDiagnostics": {
      "allOf": [{"$ref": "#/$defs/historyBase"}], "type": "object", "unevaluatedProperties": false,
      "required": ["maximum_row_scaled_residual_k", "solid_fluid_faces", "factorizations", "constant_mode_condition_indicator", "constant_mode_solve_residual"],
      "properties": {
        "maximum_row_scaled_residual_k": {"$ref": "#/$defs/nonnegative"},
        "solid_fluid_faces": {"type": "integer", "minimum": 0, "maximum": 24576},
        "factorizations": {"const": 1},
        "constant_mode_condition_indicator": {"type": "number", "exclusiveMinimum": 0, "maximum": 1e10},
        "constant_mode_solve_residual": {"type": "number", "minimum": 0, "maximum": 1e-6},
        "stored_energy_change_j": {"type": "number"}, "integrated_generated_heat_j": {"type": "number"},
        "integrated_outward_heat_j": {"type": "number"}, "raw_integrated_energy_balance_j": {"type": "number"}
      },
      "if": {"properties": {"time_s": {"type": "number"}}},
      "then": {"required": ["stored_energy_change_j", "integrated_generated_heat_j", "integrated_outward_heat_j", "raw_integrated_energy_balance_j"]},
      "else": {"not": {"anyOf": [
        {"required": ["stored_energy_change_j"]}, {"required": ["integrated_generated_heat_j"]},
        {"required": ["integrated_outward_heat_j"]}, {"required": ["raw_integrated_energy_balance_j"]}
      ]}}
    }
  },
  "$comment": "Schemas describe JSON structure, never physical qualification. Runtime remains authoritative for finite JSON serialization, exact grid/field shape equality, increasing axes, array cardinality products, matching final/history/frame times, interface indices/ownership, conserved balances, residual tolerances and request/result binding."
}
