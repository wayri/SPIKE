{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/structured-solid-thermal-request-v1.schema.json",
  "title": "SPIKE bounded structured solid thermal request v1",
  "type": "object",
  "required": ["contract", "grid", "materials", "material_ids", "heat_generation_w_m3", "boundaries", "study"],
  "properties": {
    "contract": {"const": "spike/structured-solid-thermal-request/v1"},
    "grid": {
      "type": "object",
      "required": ["shape", "spacing_m"],
      "properties": {
        "shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 4096}},
        "spacing_m": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}]}
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "thermal_conductivity_w_mk"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "thermal_conductivity_w_mk": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}]},
          "density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
          "specific_heat_j_kgk": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "material_ids": {"type": "array", "maxItems": 262144, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "heat_generation_w_m3": {"oneOf": [{"type": "number"}, {"type": "array", "maxItems": 262144, "items": {"type": "number"}}]},
    "boundaries": {
      "type": "object",
      "required": ["x_min", "x_max", "y_min", "y_max", "z_min", "z_max"],
      "properties": {
        "x_min": {"$ref": "#/$defs/boundary"}, "x_max": {"$ref": "#/$defs/boundary"},
        "y_min": {"$ref": "#/$defs/boundary"}, "y_max": {"$ref": "#/$defs/boundary"},
        "z_min": {"$ref": "#/$defs/boundary"}, "z_max": {"$ref": "#/$defs/boundary"}
      },
      "additionalProperties": false
    },
    "interface_contacts": {
      "type": "array", "maxItems": 32768,
      "items": {"type": "object", "required": ["materials", "resistance_m2k_w"], "properties": {"materials": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "resistance_m2k_w": {"type": "number", "minimum": 0}}, "additionalProperties": false}
    },
    "study": {
      "oneOf": [
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "steady"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "initial_temperature_k", "time_step_s", "steps"], "properties": {"type": {"const": "transient"}, "initial_temperature_k": {"type": "number", "minimum": 0}, "time_step_s": {"type": "number", "exclusiveMinimum": 0}, "steps": {"type": "integer", "minimum": 1, "maximum": 10000}, "output_stride": {"type": "integer", "minimum": 1, "maximum": 10000}}, "additionalProperties": false}
      ]
    },
    "solver": {"type": "object", "properties": {"radiation_tolerance_k": {"type": "number", "minimum": 1e-14}, "radiation_max_iterations": {"type": "integer", "minimum": 1, "maximum": 200}}, "additionalProperties": false}
  },
  "$defs": {
    "boundary": {
      "oneOf": [
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "adiabatic"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "temperature_k"], "properties": {"type": {"const": "temperature"}, "temperature_k": {"type": "number", "minimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "ambient_temperature_k", "heat_transfer_coefficient_w_m2k"], "properties": {"type": {"const": "convection"}, "ambient_temperature_k": {"type": "number", "minimum": 0}, "heat_transfer_coefficient_w_m2k": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "inward_heat_flux_w_m2"], "properties": {"type": {"const": "heat_flux"}, "inward_heat_flux_w_m2": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "ambient_temperature_k", "emissivity"], "properties": {"type": {"const": "radiation"}, "ambient_temperature_k": {"type": "number", "minimum": 0}, "emissivity": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}
      ]
    }
  },
  "additionalProperties": false
}
