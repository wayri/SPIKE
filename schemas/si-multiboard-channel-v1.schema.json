{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/si-multiboard-channel-v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT; Copyright (c) 2026 SigHarmonic",
  "title": "Explicit bounded two-port multiboard chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "segments", "reference_impedance_ohm"],
  "properties": {
    "kind": {"const": "multiboard"},
    "reference_impedance_ohm": {"type": "number", "minimum": 0.01, "maximum": 1000000},
    "segments": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "owner_id", "model_sha256", "channel", "input_port", "output_port", "reference_plane_in", "reference_plane_out"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "role": {"enum": ["board", "connector", "cable"]},
        "owner_id": {"$ref": "#/$defs/identity"},
        "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "input_port": {"type": "integer", "enum": [0, 1]},
        "output_port": {"type": "integer", "enum": [0, 1]},
        "reference_plane_in": {"$ref": "#/$defs/identity"},
        "reference_plane_out": {"$ref": "#/$defs/identity"},
        "channel": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind", "name", "text"],
             "properties": {"kind": {"const": "touchstone"}, "name": {"type": "string", "maxLength": 256}, "text": {"type": "string", "maxLength": 8388608}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "coupled"],
             "properties": {
               "kind": {"const": "rlgc"}, "coupled": {"const": false},
               "length_m": {"type": "number", "minimum": 1e-9, "maximum": 100},
               "resistance_ohm_per_m": {"type": "number", "minimum": 0, "maximum": 1000000},
               "inductance_h_per_m": {"type": "number", "minimum": 1e-15, "maximum": 1},
               "capacitance_f_per_m": {"type": "number", "minimum": 1e-18, "maximum": 1},
               "loss_tangent": {"type": "number", "minimum": 0, "maximum": 1},
               "inductive_coupling": {"type": "number", "minimum": 0, "maximum": 0.95},
               "capacitive_coupling": {"type": "number", "minimum": 0, "maximum": 0.95},
               "frequency_stop_hz": {"type": "number", "minimum": 1, "maximum": 1e14},
               "frequency_points": {"type": "integer", "minimum": 3, "maximum": 8193},
               "reference_impedance_ohm": {"type": "number", "minimum": 0.01, "maximum": 1000000}
             }}
          ]
        }
      }
    }
  }
}
