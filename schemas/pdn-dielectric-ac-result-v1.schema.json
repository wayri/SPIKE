{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/pdn-dielectric-ac-result/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0; dimensions, finite RMS values and numerical gates are additionally checked by the solver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "model",
    "nodes",
    "electrodes",
    "reference_electrode",
    "outer_boundary",
    "electrode_lineage",
    "mesh_lineage",
    "ac",
    "diagnostics",
    "limitations",
    "context_digest",
    "mesh_digest",
    "input_digest"
  ],
  "properties": {
    "contract": {
      "const": "spike/pdn-dielectric-ac-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "model": {
      "const": "retained_dielectric_p1_complex_admittance"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "electrodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "node",
          "vertices"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "reference_electrode": {
      "type": "object",
      "required": [
        "id",
        "node",
        "vertices"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "vertices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1000,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "outer_boundary": {
      "const": "insulating"
    },
    "electrode_lineage": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object"
      }
    },
    "mesh_lineage": {
      "type": "object"
    },
    "ac": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frequency_hz",
          "admittance_s",
          "basis_node_potential_v",
          "basis_cell_electric_field_v_m",
          "electrode_basis_current_a",
          "field_power_matrix_s",
          "diagnostics"
        ],
        "properties": {
          "frequency_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "admittance_s": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/complex"
              }
            }
          },
          "basis_node_potential_v": {
            "type": "array",
            "minItems": 4,
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/complex"
              }
            }
          },
          "basis_cell_electric_field_v_m": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 15,
                "items": {
                  "$ref": "#/$defs/complex"
                }
              }
            }
          },
          "electrode_basis_current_a": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 16,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/complex"
              }
            }
          },
          "field_power_matrix_s": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/complex"
              }
            }
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "free_relative_residual",
              "relative_backward_error",
              "equilibrated_free_condition_number",
              "relative_power_identity_error",
              "relative_reciprocity_error",
              "relative_current_balance_error",
              "minimum_dissipative_eigenvalue_s",
              "passivity_tolerance_s"
            ],
            "properties": {
              "free_relative_residual": {
                "type": "number",
                "minimum": 0
              },
              "relative_backward_error": {
                "type": "number",
                "minimum": 0
              },
              "equilibrated_free_condition_number": {
                "type": "number",
                "minimum": 0
              },
              "relative_power_identity_error": {
                "type": "number",
                "minimum": 0
              },
              "relative_reciprocity_error": {
                "type": "number",
                "minimum": 0
              },
              "relative_current_balance_error": {
                "type": "number",
                "minimum": 0
              },
              "passivity_tolerance_s": {
                "type": "number",
                "minimum": 0
              },
              "minimum_dissipative_eigenvalue_s": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mesh_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "complex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real",
        "imag"
      ],
      "properties": {
        "real": {
          "type": "number"
        },
        "imag": {
          "type": "number"
        }
      }
    }
  }
}
