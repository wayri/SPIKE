{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/coupled-surface-exchange-request-v1.schema.json",
  "title": "Experimental supplied-overlap conservative heat/traction exchange",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "transfer_id", "quantity", "normal_relation", "units", "source_patch", "destination_patch", "overlaps", "context_digest", "source_values"],
  "dependentRequired": {"destination_values": ["destination_value_unit"], "destination_value_unit": ["destination_values"]},
  "properties": {
    "contract": {"const": "spike/coupled-surface-exchange-request/v1"},
    "transfer_id": {"$ref": "#/$defs/id"},
    "quantity": {"enum": ["heat_flux", "traction"]},
    "normal_relation": {"const": "opposite_outward_normals"},
    "units": {"type": "object", "additionalProperties": false,
      "required": ["length", "area", "source_intensive", "destination_integrated"],
      "properties": {"length": {"const": "m"}, "area": {"const": "m2"},
        "source_intensive": {"enum": ["W/m2", "N/m2"]}, "destination_integrated": {"enum": ["W", "N"]}}},
    "source_patch": {"$ref": "#/$defs/patch"}, "destination_patch": {"$ref": "#/$defs/patch"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "overlaps": {"type": "array", "minItems": 1, "maxItems": 8192,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["source_face_id", "destination_face_id", "area_m2"],
        "properties": {"source_face_id": {"$ref": "#/$defs/id"}, "destination_face_id": {"$ref": "#/$defs/id"},
          "area_m2": {"type": "number", "exclusiveMinimum": 0}}}},
    "source_values": {"$ref": "#/$defs/values"}, "destination_values": {"$ref": "#/$defs/values"},
    "destination_value_unit": {"enum": ["K", "m", "m/s"]}
  },
  "allOf": [{"if": {"properties": {"quantity": {"const": "heat_flux"}}},
    "then": {"properties": {"units": {"properties": {"source_intensive": {"const": "W/m2"}, "destination_integrated": {"const": "W"}}},
      "source_values": {"items": {"properties": {"value": {"type": "number"}}}},
      "destination_values": {"items": {"properties": {"value": {"type": "number"}}}},
      "destination_value_unit": {"const": "K"}}},
    "else": {"properties": {"units": {"properties": {"source_intensive": {"const": "N/m2"}, "destination_integrated": {"const": "N"}}},
      "source_values": {"items": {"properties": {"value": {"$ref": "#/$defs/vector"}}}},
      "destination_values": {"items": {"properties": {"value": {"$ref": "#/$defs/vector"}}}},
      "destination_value_unit": {"enum": ["m", "m/s"]}}}}],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "patch": {"type": "object", "additionalProperties": false,
      "required": ["participant_id", "patch_id", "geometry_digest", "frame", "faces"],
      "properties": {"participant_id": {"$ref": "#/$defs/id"}, "patch_id": {"$ref": "#/$defs/id"},
        "geometry_digest": {"$ref": "#/$defs/digest"},
        "frame": {"type": "object", "additionalProperties": false, "required": ["id", "rank", "handedness"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "rank": {"const": 3}, "handedness": {"const": "right"}}},
        "faces": {"type": "array", "minItems": 1, "maxItems": 511,
          "items": {"type": "object", "additionalProperties": false, "required": ["id", "area_m2"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "area_m2": {"type": "number", "exclusiveMinimum": 0}}}}}},
    "values": {"type": "array", "minItems": 1, "maxItems": 511,
      "items": {"type": "object", "additionalProperties": false, "required": ["face_id", "value"],
        "properties": {"face_id": {"$ref": "#/$defs/id"}, "value": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/vector"}]}}}}
  },
  "$comment": "Semantic checks also enforce total faces<=512, identical frames, complete coverage without renormalization, exact IDs and context digest, finite arithmetic and representable products. Supplied geometry is not authenticated."
}
