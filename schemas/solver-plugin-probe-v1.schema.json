{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/solver-plugin-probe-v1.schema.json",
  "title": "SPIKE Process Solver Runtime Probe v1",
  "description": "A fixed-argv, no-shell runtime probe. A successful probe is adapter evidence only, never product or workflow qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "argv", "timeout_s", "result_contract"],
  "properties": {
    "contract": {"const": "spike/solver-plugin-probe/v1"},
    "argv": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$"}
    },
    "timeout_s": {"type": "integer", "minimum": 1, "maximum": 60},
    "result_contract": {"const": "spike/solver-plugin-probe-result/v1"}
  }
}
