{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/voice-coil-drive-v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright (c) 2026 SigHarmonic. Runtime also enforces finite arithmetic, conditioning and step budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "provenance",
    "resistance_ohm",
    "inductance_h",
    "force_constant_n_per_a",
    "mass_kg",
    "damping_n_s_per_m",
    "spring_n_per_m",
    "spring_equilibrium_position_m",
    "voltage_v",
    "initial_current_a",
    "initial_position_m",
    "initial_velocity_m_per_s",
    "duration_s",
    "time_step_s"
  ],
  "properties": {
    "contract": {
      "const": "spike/voice-coil-drive/v1"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "resistance_ohm": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "inductance_h": {
      "type": "number",
      "minimum": 1e-12,
      "maximum": 1000000
    },
    "force_constant_n_per_a": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "mass_kg": {
      "type": "number",
      "minimum": 1e-12,
      "maximum": 1000000
    },
    "damping_n_s_per_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "spring_n_per_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "spring_equilibrium_position_m": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "voltage_v": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "initial_current_a": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    },
    "initial_position_m": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "initial_velocity_m_per_s": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    },
    "time_step_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    }
  }
}
