{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/mcad-assembly-v1.schema.json",
  "title": "SPIKE named mechanical assembly v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "spike/mcad-assembly/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "units": {
      "const": "mm"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "kind": {
            "enum": [
              "assembly",
              "board",
              "dielectric",
              "copper",
              "component",
              "cell",
              "harness",
              "insulation",
              "mechanical"
            ]
          },
          "parent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "transform": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {
              "type": "number"
            }
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "box"
                  },
                  "size_mm": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "type",
                  "size_mm"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "cylinder"
                  },
                  "radius_mm": {
                    "type": "number"
                  },
                  "height_mm": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "radius_mm",
                  "height_mm"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "extrusion"
                  },
                  "rings": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "role": {
                          "enum": [
                            "outer",
                            "cutout"
                          ]
                        },
                        "start_mm": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        },
                        "segments": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 100000,
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "kind": {
                                    "const": "line"
                                  },
                                  "end_mm": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                      "type": "number"
                                    }
                                  }
                                },
                                "required": [
                                  "kind",
                                  "end_mm"
                                ]
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "kind": {
                                    "const": "arc"
                                  },
                                  "end_mm": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                      "type": "number"
                                    }
                                  },
                                  "mid_mm": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                      "type": "number"
                                    }
                                  }
                                },
                                "required": [
                                  "kind",
                                  "end_mm",
                                  "mid_mm"
                                ]
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "role",
                        "start_mm",
                        "segments"
                      ]
                    }
                  },
                  "height_mm": {
                    "type": "number"
                  },
                  "z_mm": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "rings",
                  "height_mm"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "route"
                  },
                  "points_mm": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 100000,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "radius_mm": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "points_mm",
                  "radius_mm"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "step"
                  },
                  "data_base64": {
                    "type": "string",
                    "maxLength": 90000000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "type",
                  "data_base64",
                  "sha256"
                ]
              }
            ]
          },
          "properties": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "color_rgb": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    },
    "materials": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "properties": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "properties": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "contract",
    "id",
    "name",
    "units",
    "objects"
  ]
}
