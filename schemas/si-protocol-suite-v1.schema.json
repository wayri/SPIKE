{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/si-protocol-suite-v1.schema.json",
  "title": "SPIKE declarative SI protocol suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "name", "family", "revision", "description", "signaling", "encoding", "topology", "requiredInputs", "analyses", "rules", "provenance", "qualification", "custom"],
  "properties": {
    "contract": { "const": "spike/si-protocol-suite/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "family": { "enum": ["DDR", "GDDR", "SERDES", "LVDS", "PCI", "PCIE", "PXI", "DISPLAYPORT", "HDMI", "USB", "ETHERNET", "MIPI", "SATA", "CXL", "JESD204", "HBM", "CUSTOM"] },
    "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "signaling": { "enum": ["single_ended", "differential", "parallel_bus", "mixed"] },
    "encoding": { "enum": ["NRZ", "PAM4", "mixed", "user_defined"] },
    "topology": { "$ref": "#/$defs/stringList" },
    "requiredInputs": { "$ref": "#/$defs/stringList" },
    "analyses": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "requiredCapabilities", "status"],
        "properties": {
          "id": { "enum": ["topology", "impedance", "rlgc", "s_parameters", "tdr_tdt", "insertion_return_loss", "next_fext", "mode_conversion", "skew_delay", "eye", "jitter", "pam4", "power_aware", "compliance_review"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "requiredCapabilities": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$" }, "uniqueItems": true },
          "status": { "enum": ["available_input_review", "solver_gated"] }
        }
      }
    },
    "rules": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "metric", "operator", "unit", "source", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
          "metric": { "type": "string", "minLength": 1, "maxLength": 160 },
          "operator": { "enum": ["minimum", "maximum", "range", "informational"] },
          "value": { "type": "number" },
          "maximum": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
          "source": { "enum": ["user", "licensed_standard", "measurement", "public_reference"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "locator", "access", "reviewedOn"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "access": { "enum": ["public_overview", "licensed_standard_required", "user_defined"] },
        "reviewedOn": { "type": "string", "format": "date" }
      }
    },
    "qualification": { "enum": ["setup_only", "experimental", "validated"] },
    "custom": { "type": "boolean" }
  },
  "$defs": {
    "stringList": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  }
}
