{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/gmsh-mesh-v1.schema.json",
  "title": "Complete geometry-only Gmsh tetrahedral result",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "status", "solved", "model_status", "production_qualified", "units", "coordinate_frame", "solver_mesh", "nodes_mm", "tetrahedra", "triangles", "boundary_faces", "interface_faces", "metrics", "fragment_ownership", "geometry_evidence", "provenance", "compatibility"],
  "properties": {
    "contract": {"const": "spike/gmsh-mesh/v1"}, "status": {"const": "completed"},
    "solved": {"const": false}, "production_qualified": {"const": false}, "model_status": {"const": "experimental"},
    "units": {"const": "mm"}, "coordinate_frame": {"const": "normalized_board_local_mm"},
    "solver_mesh": {"$ref": "solver-mesh-v1.schema.json"},
    "nodes_mm": {"type": "array", "minItems": 4, "maxItems": 100000, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "tetrahedra": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}},
    "triangles": {"type": "array", "maxItems": 400000, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}},
    "boundary_faces": {"type": "array", "maxItems": 400000, "items": {"$ref": "#/$defs/face"}},
    "interface_faces": {"type": "array", "maxItems": 400000, "items": {"$ref": "#/$defs/face"}},
    "metrics": {"type": "object"}, "fragment_ownership": {"type": "object"}, "geometry_evidence": {"type": "object"},
    "provenance": {"type": "object", "required": ["extension_id", "design_id", "design_digest_sha256", "request_sha256", "job_sha256", "mesh_sha256", "runtime", "operation", "geometry_source"], "properties": {
      "extension_id": {"const": "spike.gmsh-suite"}, "operation": {"const": "mesh_only"},
      "design_id": {"type": "string"}, "design_digest_sha256": {"$ref": "#/$defs/digest"},
      "request_sha256": {"$ref": "#/$defs/digest"}, "job_sha256": {"$ref": "#/$defs/digest"}, "mesh_sha256": {"$ref": "#/$defs/digest"},
      "runtime": {"type": "object"}, "geometry_source": {"const": "explicit_normalized_complete_pcb_volume_model"}
    }},
    "compatibility": {"type": "object", "required": ["thermal", "em", "si"], "additionalProperties": {"type": "string"}},
    "admission": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "face": {"type": "object", "additionalProperties": false, "required": ["vertices", "cad_surface_tag", "cell_ids", "material_ids", "source_object_ids"], "properties": {
      "vertices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
      "cad_surface_tag": {"type": "integer"}, "cell_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
      "material_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
      "source_object_ids": {"type": "array", "items": {"type": "string"}}
    }}
  }
}
