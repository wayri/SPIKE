{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/pcb-reference-plane-antipad-mesh-v1.schema.json",
  "title": "SPIKE complete reference-plane antipad mesh v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "source", "center_mm", "radial_segments", "tessellation", "vertices_mm", "triangles", "domains", "boundary_loops", "resources", "qualification", "topology_audit"],
  "properties": {
    "contract": {"const": "spike/pcb-reference-plane-antipad-mesh/v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["geometry_contract", "geometry_sha256", "design_id", "via_id", "source_via_id"],
      "properties": {
        "geometry_contract": {"const": "spike/pcb-reference-plane-antipad-geometry/v1"},
        "geometry_sha256": {"$ref": "#/$defs/digest"}, "design_id": {"$ref": "#/$defs/id"},
        "via_id": {"$ref": "#/$defs/id"}, "source_via_id": {"type": "string", "maxLength": 256}
      }
    },
    "center_mm": {"$ref": "#/$defs/point2"},
    "radial_segments": {"type": "integer", "minimum": 8, "maximum": 128, "multipleOf": 4},
    "tessellation": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate_tolerance_mm", "antipad_boundary", "source_outer_boundary"],
      "properties": {
        "coordinate_tolerance_mm": {"type": "number", "exclusiveMinimum": 0},
        "antipad_boundary": {"const": "circumscribed"},
        "source_outer_boundary": {"const": "exact_constrained_segments"}
      }
    },
    "vertices_mm": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/point3"}},
    "triangles": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/triangle"}},
    "domains": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/domain"}},
    "boundary_loops": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/loop"}},
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["max_vertices", "max_triangles", "actual_vertices", "actual_triangles", "max_serialized_bytes"],
      "properties": {
        "max_vertices": {"const": 32768}, "max_triangles": {"const": 65536},
        "actual_vertices": {"type": "integer", "minimum": 1, "maximum": 32768},
        "actual_triangles": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_serialized_bytes": {"const": 8388608}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "native_handoff_ready", "physics_convergence_performed", "capacitance_ready", "si_ready", "solver_ready"],
      "properties": {
        "state": {"const": "full_reference_zone_geometry_mesh_only"},
        "native_handoff_ready": {"const": false}, "physics_convergence_performed": {"const": false},
        "capacitance_ready": {"const": false}, "si_ready": {"const": false}, "solver_ready": {"const": false}
      }
    },
    "topology_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["zero_area_triangles", "duplicate_triangles", "nonmanifold_or_boundary_edges", "orientation_mismatches", "unused_vertices", "reference_void_violations", "closed_domains", "passed"],
      "properties": {
        "zero_area_triangles": {"const": 0}, "duplicate_triangles": {"const": 0},
        "nonmanifold_or_boundary_edges": {"const": 0}, "orientation_mismatches": {"const": 0},
        "unused_vertices": {"const": 0}, "reference_void_violations": {"const": 0},
        "closed_domains": {"type": "integer", "minimum": 1, "maximum": 64}, "passed": {"const": true}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point2": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "point3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
    "sources": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "triangle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain_id", "vertex_indices", "surface_role", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "domain_id": {"$ref": "#/$defs/id"},
        "vertex_indices": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "minItems": 3, "maxItems": 3},
        "surface_role": {"enum": ["reference_zone_upper_face", "reference_zone_lower_face", "reference_zone_outer_boundary", "antipad_void_boundary"]},
        "source_ids": {"$ref": "#/$defs/sources"}
      }
    },
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "net_id", "layer_ids", "source_ids", "triangle_ids", "reference_zone_id", "source_zone_sha256", "resolved_region_sha256", "antipad_radius_mm"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"const": "reference_plane_full_zone"},
        "net_id": {"$ref": "#/$defs/id"}, "layer_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/id"}},
        "source_ids": {"$ref": "#/$defs/sources"}, "triangle_ids": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/id"}},
        "reference_zone_id": {"$ref": "#/$defs/id"}, "source_zone_sha256": {"$ref": "#/$defs/digest"},
        "resolved_region_sha256": {"$ref": "#/$defs/digest"}, "antipad_radius_mm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "loop": {
      "type": "object", "additionalProperties": false,
      "required": ["loop_id", "domain_id", "role", "z_mm", "vertex_indices", "source_ids"],
      "properties": {
        "loop_id": {"$ref": "#/$defs/id"}, "domain_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["source_outer", "antipad_hole"]}, "z_mm": {"type": "number"},
        "vertex_indices": {"type": "array", "minItems": 3, "maxItems": 8192, "items": {"type": "integer", "minimum": 0}},
        "source_ids": {"$ref": "#/$defs/sources"}
      }
    }
  }
}
