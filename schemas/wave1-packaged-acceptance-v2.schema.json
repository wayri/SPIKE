{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/wave1-packaged-acceptance-v2.schema.json",
  "title": "SPIKE Wave 1 Packaged Assembly Acceptance v2",
  "description": "Wave 1 acceptance report for a signed but not production-qualified Windows candidate.",
  "type": "object",
  "required": ["contract", "generated_at", "status", "automated", "human", "candidate", "worker", "fixture", "runtime", "qualification"],
  "properties": {
    "contract": {"const": "spike/wave1-packaged-acceptance/v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed", "pending_human"]},
    "automated": {"$ref": "#/$defs/section"},
    "human": {"$ref": "#/$defs/human"},
    "candidate": {
      "type": "object",
      "required": ["contract", "manifest", "manifest_sha256", "generated_at", "version", "application_version", "channel", "release_state", "production_qualified", "signing_policy", "artifacts"],
      "properties": {
        "contract": {"const": "spike/windows-installer-manifest/v2"},
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "application_version": {"type": "string", "minLength": 1},
        "channel": {"const": "production-candidate"},
        "release_state": {"const": "production-candidate"},
        "production_qualified": {"const": false},
        "signing_policy": {"$ref": "#/$defs/signing_policy"},
        "artifacts": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/artifact"},
          "allOf": [
            {"contains": {"properties": {"kind": {"const": "msi"}}, "required": ["kind"]}},
            {"contains": {"properties": {"kind": {"const": "nsis"}}, "required": ["kind"]}}
          ]
        }
      },
      "additionalProperties": false
    },
    "worker": {"type": "object"},
    "fixture": {"type": "object"},
    "runtime": {"type": "object", "required": ["generated_at", "source_snapshot_digest", "packaged_snapshot_digest"], "properties": {"generated_at": {}, "source_snapshot_digest": {}, "packaged_snapshot_digest": {}}, "additionalProperties": false},
    "qualification": {"type": "object", "required": ["assembly_foundation", "physics", "solver_ready"], "properties": {"assembly_foundation": {"enum": ["packaged_acceptance", "contract_tested"]}, "physics": {"const": "not_qualified"}, "solver_ready": {"const": false}}, "additionalProperties": false}
  },
  "$defs": {
    "thumbprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
    "signing_policy": {
      "type": "object",
      "required": ["required", "expected_signer_thumbprint", "digest_algorithm", "timestamp_required", "timestamp_protocol"],
      "properties": {
        "required": {"const": true},
        "expected_signer_thumbprint": {"$ref": "#/$defs/thumbprint"},
        "digest_algorithm": {"const": "sha256"},
        "timestamp_required": {"const": true},
        "timestamp_protocol": {"const": "rfc3161"}
      },
      "additionalProperties": false
    },
    "authenticode": {
      "type": "object",
      "required": ["status", "file_digest_algorithm", "signer_thumbprint", "timestamp_protocol", "timestamp_authority_thumbprint"],
      "properties": {
        "status": {"const": "Valid"},
        "file_digest_algorithm": {"const": "sha256"},
        "signer_thumbprint": {"$ref": "#/$defs/thumbprint"},
        "signer_subject": {"type": "string"},
        "timestamp_protocol": {"const": "rfc3161"},
        "timestamp_authority_thumbprint": {"$ref": "#/$defs/thumbprint"},
        "timestamp_authority_subject": {"type": "string"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["file", "kind", "size", "sha256", "authenticode"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "kind": {"enum": ["msi", "nsis"]},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authenticode": {"$ref": "#/$defs/authenticode"}
      },
      "additionalProperties": false
    },
    "summary": {"type": "object", "required": ["total", "passed", "failed"], "properties": {"total": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "check": {"type": "object", "required": ["id", "status", "detail", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed"]}, "detail": {"type": "string"}, "evidence": {"type": "object"}}, "additionalProperties": false},
    "section": {"type": "object", "required": ["status", "summary", "checks"], "properties": {"status": {"enum": ["passed", "failed"]}, "summary": {"$ref": "#/$defs/summary"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}}, "additionalProperties": false},
    "human": {"type": "object", "required": ["status", "summary", "checks"], "properties": {"status": {"enum": ["passed", "failed", "pending"]}, "summary": {"$ref": "#/$defs/summary"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}, "evidence": {"type": ["string", "null"]}, "reviewer": {}, "reviewed_at": {}, "environment": {}, "installer_file": {}, "installer_sha256": {}, "installer_manifest_sha256": {}, "authenticode": {}, "before_manifest_payload_sha256": {}, "after_manifest_payload_sha256": {}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
