{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/pdn-dielectric-thermal-request/v1",
  "$comment": "SPDX-License-Identifier: Apache-2.0; strict mesh identity, coherent RMS drive, conservative heat and existing solver admission are additionally checked by typed implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "electrical_request",
    "drive",
    "thermal_request"
  ],
  "properties": {
    "contract": {
      "const": "spike/pdn-dielectric-thermal-request/v1"
    },
    "electrical_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "mesh",
        "materials",
        "electrodes",
        "reference_electrode",
        "outer_boundary",
        "context_digest",
        "frequencies_hz"
      ],
      "properties": {
        "contract": {
          "const": "spike/pdn-dielectric-ac-request/v1"
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "units",
            "coordinate_system",
            "vertices",
            "cells",
            "object_map",
            "counts"
          ],
          "properties": {
            "contract": {
              "const": "spike/solver-mesh/v1"
            },
            "units": {
              "enum": [
                "m",
                "mm"
              ]
            },
            "coordinate_system": {
              "enum": [
                "right_handed_xyz"
              ]
            },
            "vertices": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false
              },
              "minItems": 4
            },
            "cells": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "vertices",
                  "source_object_ids",
                  "material_id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "kind": {
                    "const": "tetrahedron"
                  },
                  "vertices": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "source_object_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1024,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "material_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "minItems": 1
            },
            "object_map": {
              "type": "object",
              "maxProperties": 1000000,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "net": {
                    "type": "string"
                  },
                  "layer": {
                    "type": "string"
                  }
                }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vertices",
                "cells"
              ],
              "properties": {
                "vertices": {
                  "type": "integer",
                  "minimum": 0
                },
                "cells": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "permittivity_f_m",
              "conductivity_s_m",
              "loss_tangent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "permittivity_f_m": {
                "oneOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                ]
              },
              "conductivity_s_m": {
                "type": "number",
                "minimum": 0
              },
              "loss_tangent": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "electrodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "node",
              "vertices"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "vertices": {
                "type": "array",
                "minItems": 3,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "reference_electrode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "outer_boundary": {
          "const": "insulating"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frequencies_hz": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "voltages_v"
      ],
      "properties": {
        "frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voltages_v": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 15,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "imag"
            ],
            "properties": {
              "real": {
                "type": "number"
              },
              "imag": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "thermal_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "mesh",
        "materials",
        "boundaries"
      ],
      "properties": {
        "contract": {
          "const": "spike/assembly-tetra-thermal-request/v1"
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "units",
            "coordinate_system",
            "vertices",
            "cells",
            "object_map",
            "counts"
          ],
          "properties": {
            "contract": {
              "const": "spike/solver-mesh/v1"
            },
            "units": {
              "enum": [
                "m",
                "mm"
              ]
            },
            "coordinate_system": {
              "enum": [
                "right_handed_xyz"
              ]
            },
            "vertices": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false
              },
              "minItems": 4
            },
            "cells": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "vertices",
                  "source_object_ids",
                  "material_id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "kind": {
                    "const": "tetrahedron"
                  },
                  "vertices": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "source_object_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1024,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "material_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "minItems": 1
            },
            "object_map": {
              "type": "object",
              "maxProperties": 1000000,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "net": {
                    "type": "string"
                  },
                  "layer": {
                    "type": "string"
                  }
                }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vertices",
                "cells"
              ],
              "properties": {
                "vertices": {
                  "type": "integer",
                  "minimum": 0
                },
                "cells": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "thermal_conductivity_w_mk"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "thermal_conductivity_w_mk": {
                "oneOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "maxItems": 8000,
          "items": {
            "type": "object"
          }
        },
        "mode": {
          "const": "steady_state"
        },
        "heat_sources_w_m3": {
          "type": "object",
          "maxProperties": 0
        },
        "contacts": {
          "type": "array",
          "maxItems": 8000,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
