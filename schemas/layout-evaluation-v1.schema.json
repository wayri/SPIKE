{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/layout-evaluation-v1.schema.json",
  "title": "SPIKE Layout Evaluation Orchestration v1",
  "description": "Strict candidate-evaluation boundary for custom autorouters and autoplacers. It orchestrates physics jobs but does not claim routing, placement, DRC, or solver validity.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" },
    "dimensionExponent": {
      "oneOf": [
        { "type": "integer", "minimum": -1024, "maximum": 1024 },
        { "type": "array", "prefixItems": [{ "type": "integer", "minimum": -1024, "maximum": 1024 }, { "type": "integer", "minimum": 1, "maximum": 1024 }], "minItems": 2, "maxItems": 2 }
      ]
    },
    "dimension": { "type": "array", "prefixItems": [
      { "$ref": "#/$defs/dimensionExponent" }, { "$ref": "#/$defs/dimensionExponent" },
      { "$ref": "#/$defs/dimensionExponent" }, { "$ref": "#/$defs/dimensionExponent" },
      { "$ref": "#/$defs/dimensionExponent" }, { "$ref": "#/$defs/dimensionExponent" },
      { "$ref": "#/$defs/dimensionExponent" }
    ], "minItems": 7, "maxItems": 7 },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "contract"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "contract": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "designArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "contract"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "contract": { "const": "spike/design-ir/v2" }
      }
    },
    "physicsArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "contract"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "contract": { "const": "spike/physics-model/v1" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["frame", "entity_ids"],
      "properties": {
        "frame": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entity_ids": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "evaluator", "kind", "metric_id", "relation", "dimension", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "evaluator": { "enum": ["cad_drc", "native_solver", "custom"] },
        "kind": { "enum": ["hard_constraint", "soft_constraint", "objective"] },
        "metric_id": { "$ref": "#/$defs/identifier" },
        "result_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "relation": { "enum": ["le", "ge", "between", "target", "minimize", "maximize"] },
        "dimension": { "$ref": "#/$defs/dimension" },
        "lower_si": { "type": "number" }, "upper_si": { "type": "number" },
        "target_si": { "type": "number" }, "absolute_tolerance_si": { "type": "number", "minimum": 0 },
        "weight": { "type": "number", "exclusiveMinimum": 0 }, "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "study": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["stationary", "transient"] }, "integrator": { "enum": ["backward_euler", "bdf2"] },
        "time_step": { "type": "number", "exclusiveMinimum": 0 }, "steps": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "physicsEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement_ids", "model", "study", "requested_outputs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "requirement_ids": { "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "model": { "$ref": "#/$defs/physicsArtifact" }, "study": { "$ref": "#/$defs/study" },
        "requested_outputs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "enum": ["summary", "issues", "fields", "mesh", "convergence", "conservation", "profiling", "checkpoint"] } }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["max_memory_bytes", "max_wall_time_s", "ranks", "threads"],
      "properties": {
        "max_memory_bytes": { "type": "integer", "minimum": 16777216, "maximum": 1125899906842624 },
        "max_wall_time_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 604800 },
        "ranks": { "type": "integer", "minimum": 1, "maximum": 65536 }, "threads": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "record_type", "evaluation_id", "consumer", "candidate", "requirements", "physics_evaluations", "resources", "deterministic"],
      "properties": {
        "contract": { "const": "spike/layout-evaluation/v1" }, "record_type": { "const": "request" },
        "evaluation_id": { "$ref": "#/$defs/identifier" },
        "consumer": { "type": "object", "additionalProperties": false, "required": ["kind", "implementation"], "properties": {
          "kind": { "enum": ["autorouter", "autoplacer", "joint"] },
          "implementation": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 }
        } },
        "candidate": { "$ref": "#/$defs/designArtifact" }, "baseline": { "$ref": "#/$defs/designArtifact" },
        "parent_candidate_sha256": { "$ref": "#/$defs/sha256" },
        "changed_entity_ids": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "requirements": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/requirement" } },
        "physics_evaluations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/physicsEvaluation" } },
        "resources": { "$ref": "#/$defs/resources" }, "deterministic": { "type": "boolean" }
      }
    },
    "requirementResult": {
      "type": "object", "additionalProperties": false, "required": ["requirement_id", "metric_id", "status", "validation_state"],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/identifier" }, "metric_id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["satisfied", "violated", "evaluated", "unknown", "unsupported", "error"] },
        "validation_state": { "enum": ["qualified", "validated", "reference_validated", "verification_only", "cad_drc", "experimental", "approximate", "unvalidated", "unsupported"] },
        "value_si": { "type": "number" }, "margin_si": { "type": "number" }
      }
    },
    "nativeJobResult": {
      "type": "object", "additionalProperties": false, "required": ["physics_evaluation_id", "request_id", "status"],
      "properties": {
        "physics_evaluation_id": { "$ref": "#/$defs/identifier" }, "request_id": { "$ref": "#/$defs/identifier" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "record_type", "evaluation_id", "candidate_sha256", "status", "feasible", "requirements", "native_jobs"],
      "properties": {
        "contract": { "const": "spike/layout-evaluation/v1" }, "record_type": { "const": "result" },
        "evaluation_id": { "$ref": "#/$defs/identifier" }, "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["completed", "partial", "failed", "cancelled", "unsupported"] }, "feasible": { "type": "boolean" },
        "requirements": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/requirementResult" } },
        "native_jobs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/nativeJobResult" } }
      }
    }
  }
}
