{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/rlgc-line-fields-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "line_request",
    "excitations",
    "probes"
  ],
  "properties": {
    "contract": {
      "const": "spike/rlgc-line-fields-request/v1"
    },
    "line_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "length_m",
        "reference_impedance_ohm",
        "inductance_h_per_m",
        "capacitance_f_per_m",
        "samples"
      ],
      "properties": {
        "contract": {
          "const": "spike/rlgc-line-network-request/v1"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inductance_h_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacitance_f_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frequency_hz",
              "resistance_ohm_per_m",
              "conductance_s_per_m"
            ],
            "properties": {
              "frequency_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "resistance_ohm_per_m": {
                "type": "number",
                "minimum": 0
              },
              "conductance_s_per_m": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "excitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frequency_hz",
          "incident_left",
          "incident_right"
        ],
        "properties": {
          "frequency_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "incident_left": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "imag"
            ],
            "properties": {
              "real": {
                "type": "number"
              },
              "imag": {
                "type": "number"
              }
            }
          },
          "incident_right": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "real",
              "imag"
            ],
            "properties": {
              "real": {
                "type": "number"
              },
              "imag": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fractional_position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "fractional_position": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
