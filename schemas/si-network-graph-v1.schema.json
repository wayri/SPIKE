{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://spike.local/schemas/si-network-graph-v1.schema.json",
  "$comment":"SPDX-License-Identifier: Apache-2.0; Copyright (c) 2026 SigHarmonic",
  "type":"object","additionalProperties":false,
  "required":["kind","reference_impedance_ohm","nodes","connections","external_ports"],
  "properties":{
    "kind":{"const":"network_graph"},
    "reference_impedance_ohm":{"type":"number","minimum":0.01,"maximum":1000000},
    "nodes":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/node"}},
    "connections":{"type":"array","maxItems":31,"items":{"type":"object","additionalProperties":false,"required":["a","b"],"properties":{"a":{"$ref":"#/$defs/endpoint"},"b":{"$ref":"#/$defs/endpoint"}}}},
    "external_ports":{"type":"array","minItems":2,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["id","node_id","port"],"properties":{"id":{"$ref":"#/$defs/identity"},"node_id":{"$ref":"#/$defs/identity"},"port":{"type":"integer","minimum":0,"maximum":15}}}}
  },
  "$defs":{
    "identity":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "endpoint":{"type":"object","additionalProperties":false,"required":["node_id","port"],"properties":{"node_id":{"$ref":"#/$defs/identity"},"port":{"type":"integer","minimum":0,"maximum":15}}},
    "node":{"type":"object","additionalProperties":false,"required":["id","owner_id","model_sha256","channel","reference_planes"],"properties":{
      "id":{"$ref":"#/$defs/identity"},"owner_id":{"$ref":"#/$defs/identity"},"model_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
      "reference_planes":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/identity"}},
      "channel":{"$ref":"#/$defs/leaf"}}},
    "leaf":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","text"],"properties":{"kind":{"const":"touchstone"},"name":{"type":"string","maxLength":256},"text":{"type":"string","maxLength":8388608}}},
      {"type":"object","additionalProperties":false,"required":["kind"],"properties":{
        "kind":{"const":"rlgc"},"coupled":{"type":"boolean"},
        "length_m":{"type":"number","minimum":1e-9,"maximum":100},
        "resistance_ohm_per_m":{"type":"number","minimum":0,"maximum":1000000},
        "inductance_h_per_m":{"type":"number","minimum":1e-15,"maximum":1},
        "capacitance_f_per_m":{"type":"number","minimum":1e-18,"maximum":1},
        "loss_tangent":{"type":"number","minimum":0,"maximum":1},
        "inductive_coupling":{"type":"number","minimum":0,"maximum":0.95},
        "capacitive_coupling":{"type":"number","minimum":0,"maximum":0.95},
        "frequency_stop_hz":{"type":"number","minimum":1,"maximum":1e14},
        "frequency_points":{"type":"integer","minimum":3,"maximum":8193},
        "reference_impedance_ohm":{"type":"number","minimum":0.01,"maximum":1000000}}}
    ]}
  }
}
