{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/rlgc-loaded-cascade-request-v1.schema.json",
  "title": "SPIKE physical RLC loaded coupled cascade request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sections",
    "terminations",
    "sources"
  ],
  "properties": {
    "contract": {
      "const": "spike/rlgc-loaded-cascade-request/v1"
    },
    "terminations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "port",
          "resistance_ohm",
          "inductance_h",
          "capacitance_f"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "resistance_ohm": {
            "type": "number",
            "minimum": 1e-06,
            "maximum": 1000000000000.0
          },
          "inductance_h": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000.0
          },
          "capacitance_f": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "sources": {
      "$ref": "rlgc-terminated-pair-request-v1.schema.json#/properties/sources"
    },
    "sections": {
      "$ref": "rlgc-coupled-cascade-request-v1.schema.json#/properties/sections"
    }
  },
  "description": "Series R/L from Thevenin source to node and ideal shunt C from node to reference. Runtime enforces exact grids, unique IDs/complete ports, conditioning, finite arithmetic and resource limits."
}
