{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spike/distortionless-line-transient-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "line_request",
    "attenuation_rate_per_s"
  ],
  "properties": {
    "contract": {
      "const": "spike/distortionless-line-transient-request/v1"
    },
    "line_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "length_m",
        "inductance_h_per_m",
        "capacitance_f_per_m",
        "left_boundary",
        "right_boundary",
        "probes",
        "output_times_s"
      ],
      "properties": {
        "contract": {
          "const": "spike/lossless-line-transient-request/v1"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inductance_h_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacitance_f_per_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resistance_ohm",
            "voltage_points"
          ],
          "properties": {
            "resistance_ohm": {
              "type": "number",
              "minimum": 0
            },
            "voltage_points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "time_s",
                  "voltage_v"
                ],
                "properties": {
                  "time_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "voltage_v": {
                    "type": "number"
                  }
                }
              },
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "time_s",
                    "voltage_v"
                  ],
                  "properties": {
                    "time_s": {
                      "const": 0
                    },
                    "voltage_v": {
                      "const": 0
                    }
                  }
                }
              ]
            }
          }
        },
        "right_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resistance_ohm",
            "voltage_points"
          ],
          "properties": {
            "resistance_ohm": {
              "type": "number",
              "minimum": 0
            },
            "voltage_points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "time_s",
                  "voltage_v"
                ],
                "properties": {
                  "time_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "voltage_v": {
                    "type": "number"
                  }
                }
              },
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "time_s",
                    "voltage_v"
                  ],
                  "properties": {
                    "time_s": {
                      "const": 0
                    },
                    "voltage_v": {
                      "const": 0
                    }
                  }
                }
              ]
            }
          }
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "fractional_position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fractional_position": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "output_times_s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "number",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    },
    "attenuation_rate_per_s": {
      "type": "number",
      "minimum": 0
    }
  }
}
