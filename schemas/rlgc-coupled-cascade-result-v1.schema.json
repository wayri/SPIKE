{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/rlgc-coupled-cascade-result-v1.schema.json",
  "title": "SPIKE supplied coupled RLGC cascade result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_status",
    "production_qualified",
    "source_request",
    "input_digest",
    "network",
    "sections",
    "points",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "spike/rlgc-coupled-cascade-result/v1"
    },
    "model_status": {
      "const": "experimental"
    },
    "production_qualified": {
      "const": false
    },
    "source_request": {
      "$ref": "rlgc-coupled-cascade-request-v1.schema.json"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "network": {
      "$ref": "rlgc-coupled-pair-result-v1.schema.json#/properties/network"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "$ref": "rlgc-coupled-pair-result-v1.schema.json"
          }
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frequency_hz",
          "boundary_values",
          "junctions",
          "connection_condition",
          "connection_residual",
          "power_balance"
        ],
        "properties": {
          "frequency_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary_values": {
            "$ref": "rlgc-coupled-pair-result-v1.schema.json#/properties/points/items/properties/boundary_values"
          },
          "junctions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left_section_id",
                "right_section_id",
                "voltage_residual_v",
                "current_residual_a",
                "power_residual_w"
              ],
              "properties": {
                "left_section_id": {
                  "type": "string"
                },
                "right_section_id": {
                  "type": "string"
                },
                "voltage_residual_v": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "real",
                      "imag"
                    ],
                    "properties": {
                      "real": {
                        "type": "number"
                      },
                      "imag": {
                        "type": "number"
                      }
                    }
                  }
                },
                "current_residual_a": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "real",
                      "imag"
                    ],
                    "properties": {
                      "real": {
                        "type": "number"
                      },
                      "imag": {
                        "type": "number"
                      }
                    }
                  }
                },
                "power_residual_w": {
                  "type": "number"
                }
              }
            }
          },
          "connection_condition": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000000.0
          },
          "connection_residual": {
            "type": "number",
            "minimum": 0
          },
          "power_balance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conductor_loss_w",
              "dielectric_loss_w",
              "total_loss_w",
              "net_input_w",
              "residual_w"
            ],
            "properties": {
              "conductor_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "dielectric_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "total_loss_w": {
                "type": "number",
                "minimum": 0
              },
              "net_input_w": {
                "type": "number"
              },
              "residual_w": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    }
  }
}
