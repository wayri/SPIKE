{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/windows-component-inventory-v1.schema.json",
  "title": "SPIKE Windows Component Inventory v1",
  "description": "Machine-derived Windows component identity and declared-license evidence. This record grants no redistribution or notice approval.",
  "type": "object",
  "required": ["contract", "platform", "production_qualified", "sources", "components"],
  "properties": {
    "contract": {"const": "spike/windows-component-inventory/v1"},
    "platform": {"const": "windows-x64"},
    "production_qualified": {"const": false},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purl": {"type": "string", "pattern": "^pkg:[a-z0-9.+-]+/[^@?#\\s]+@[^?#\\s]+(?:\\?[^#\\s]+)?(?:#[^\\s]+)?$"},
    "source": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": {"enum": ["cargo_lock", "npm_package_lock", "python_build_lock", "python_runtime_lock"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512-sri", "cargo-sha256"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"algorithm": {"enum": ["sha256", "cargo-sha256"]}}, "required": ["algorithm"]}, "then": {"properties": {"value": {"$ref": "#/$defs/sha256"}}}},
        {"if": {"properties": {"algorithm": {"const": "sha512-sri"}}, "required": ["algorithm"]}, "then": {"properties": {"value": {"pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"}}}}
      ]
    },
    "license_evidence": {
      "type": "object",
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"enum": ["cargo-metadata-locked", "package-lock", "wheel-metadata", "vendored-wheel-metadata"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "parent_purl": {"$ref": "#/$defs/purl"}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"kind": {"const": "vendored-wheel-metadata"}}, "required": ["kind"]}, "then": {"required": ["parent_purl"]}},
        {"if": {"properties": {"kind": {"not": {"const": "vendored-wheel-metadata"}}}, "required": ["kind"]}, "then": {"not": {"required": ["parent_purl"]}}}
      ]
    },
    "component": {
      "type": "object",
      "required": ["purl", "name", "version", "ecosystem", "scope", "integrity", "declared_license", "license_evidence", "identity_sha256"],
      "properties": {
        "purl": {"$ref": "#/$defs/purl"},
        "name": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "version": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
        "ecosystem": {"enum": ["python", "npm", "rust"]},
        "scope": {"enum": ["bundled", "build-only"]},
        "integrity": {"$ref": "#/$defs/integrity"},
        "declared_license": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:.*\\S)?$"},
        "license_evidence": {"$ref": "#/$defs/license_evidence"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
