{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/mcad-session-v1.schema.json",
  "description": "Millimetres; right-handed Z-up; parent-local row-major proper rigid transforms. Runtime validation additionally enforces identities, graph topology, finite numbers, geometry closure, SHA-256 assets and bounded total input.",
  "type": "object",
  "properties": {
    "contract": {
      "const": "spike/mcad-session/v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "assembly_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "baseline_assembly_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_designs_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 16,
            "maxItems": 16
          },
          "kind": {
            "enum": [
              "board",
              "part",
              "group"
            ]
          },
          "parent_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "step"
                  },
                  "asset_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "type",
                  "asset_sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "board_outline"
                  },
                  "rings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "enum": [
                            "outer",
                            "cutout"
                          ]
                        },
                        "start_mm": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "segments": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "const": "line"
                                  },
                                  "end_mm": {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                  }
                                },
                                "required": [
                                  "kind",
                                  "end_mm"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "const": "arc"
                                  },
                                  "end_mm": {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                  },
                                  "mid_mm": {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                  }
                                },
                                "required": [
                                  "kind",
                                  "end_mm",
                                  "mid_mm"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 100000
                        }
                      },
                      "required": [
                        "role",
                        "start_mm",
                        "segments"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 256
                  },
                  "height_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "z_mm": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "rings",
                  "height_mm",
                  "z_mm"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "transform",
          "kind",
          "parent_id",
          "geometry"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 130
    },
    "assets": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "const": "step"
          },
          "data_base64": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "type",
          "data_base64"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "contract",
    "session_id",
    "project_id",
    "assembly_id",
    "baseline_assembly_sha256",
    "baseline_designs_sha256",
    "objects",
    "assets",
    "diagnostics"
  ],
  "additionalProperties": false
}
