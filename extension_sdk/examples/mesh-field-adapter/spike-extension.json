{
  "contract": "spike/extension/v1",
  "api_version": 1,
  "id": "org.example.mesh-field-adapter",
  "name": "Mesh-aware field adapter",
  "version": "1.0.0",
  "provider": "SPIKE SDK example",
  "description": "Demonstrates full topology handoff and bound field/mesh ingestion; does not solve physics.",
  "execution": "process",
  "runtime": "python",
  "entrypoint": "extension.py",
  "state": "available",
  "license": "Apache-2.0",
  "bundled": false,
  "permissions": ["design.read", "mesh.read", "results.write"],
  "limits": {"timeout_seconds": 60, "max_result_bytes": 33554432},
  "contributes": {
    "analyses": [{
      "id": "import-mesh-voltage-field",
      "name": "Import voltage field on board mesh",
      "description": "Use host mesh and geometry, then admit externally calculated voltage samples.",
      "output_contract": "spike/v1",
      "input_schema": {
        "type": "object",
        "required": ["samples"],
        "properties": {
          "mesh_spec": {"type": "object"},
          "solver": {"type": "string"},
          "samples": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["x_mm", "y_mm", "value"],
            "properties": {
              "x_mm": {"type": "number"}, "y_mm": {"type": "number"},
              "value": {"type": "number"}, "layer": {"type": "string"}
            }
          }}
        }
      }
    }]
  }
}
