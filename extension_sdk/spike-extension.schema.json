{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/spike-extension-v1.json",
  "title": "SPIKE Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "api_version",
    "id",
    "name",
    "version",
    "provider",
    "description",
    "execution",
    "runtime",
    "entrypoint",
    "contributes"
  ],
  "properties": {
    "contract": {
      "const": "spike/extension/v1"
    },
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "const": "process"
    },
    "runtime": {
      "enum": [
        "native",
        "python"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "available",
        "experimental",
        "disabled"
      ],
      "default": "available"
    },
    "license": {
      "type": "string",
      "default": "proprietary"
    },
    "bundled": {
      "type": "boolean",
      "default": false
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "design.read",
          "project.read",
          "selection.read",
          "results.read",
          "results.write",
          "project.write",
          "filesystem.workspace",
          "network",
          "harness.read"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "menu_bar": {"type": "boolean"},
        "title_bar": {"type": "boolean"},
        "menu_items": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "applications": {
          "$ref": "#/$defs/contributions"
        },
        "commands": {
          "$ref": "#/$defs/contributions"
        },
        "analyses": {
          "$ref": "#/$defs/contributions"
        },
        "importers": {
          "$ref": "#/$defs/contributions"
        },
        "exporters": {
          "$ref": "#/$defs/contributions"
        },
        "reports": {
          "$ref": "#/$defs/contributions"
        },
        "panels": {
          "$ref": "#/$defs/contributions"
        },
        "validators": {
          "$ref": "#/$defs/contributions"
        },
        "protocol_suites": {
          "$ref": "#/$defs/contributions"
        },
        "schemas": {
          "$ref": "#/$defs/contributions"
        },
        "harness_engines": {
          "$ref": "#/$defs/contributions"
        }
      }
    }
  },
  "$defs": {
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "output_contract": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
